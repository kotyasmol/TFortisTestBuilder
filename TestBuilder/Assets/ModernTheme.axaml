<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nodify="using:Nodify">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- Layout scale: 4 / 8 / 12 / 16 / 24; all dimensions are logical pixels. -->
      <x:Double x:Key="FontCaption">12</x:Double>
      <x:Double x:Key="FontBody">14</x:Double>
      <x:Double x:Key="FontSection">16</x:Double>
      <x:Double x:Key="FontHeading">20</x:Double>
      <x:Double x:Key="FontTitle">24</x:Double>
      <x:Double x:Key="ControlHeight">36</x:Double>
      <Thickness x:Key="PageInset">16</Thickness>
      <Thickness x:Key="PanelInset">16</Thickness>
      <Thickness x:Key="ControlInset">12,8</Thickness>

      <ControlTheme x:Key="ProfileItemTheme" TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                Margin="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" /></Style>
        <Style Selector="^:selected">
          <Setter Property="Background" Value="{DynamicResource ProfileSelectedBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Style>
      </ControlTheme>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#DDE3E9" />
          <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#E6EBEF" />
          <SolidColorBrush x:Key="EditorDotBrush" Color="#9CAAB8" />
          <SolidColorBrush x:Key="InactiveNodeBackgroundBrush" Color="#D9D9D9" />
          <SolidColorBrush x:Key="InactiveNodeFieldBrush" Color="#E5E5E5" />
          <SolidColorBrush x:Key="GridLineBrush" Color="#CCD4DE" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#F1F3F5" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E8ECF0" />
          <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#E0E5EB" />
          <SolidColorBrush x:Key="SurfacePressedBrush" Color="#D3DBE5" />
          <SolidColorBrush x:Key="BorderBrush" Color="#ABB7C6" />
          <SolidColorBrush x:Key="BorderStrongBrush" Color="#7D8EA3" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#202A38" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#46556B" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#536279" />
          <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
          <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
          <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E8F0FF" />
          <SolidColorBrush x:Key="ProfileSelectedBrush" Color="#CDDEFC" />
          <SolidColorBrush x:Key="PrimarySoftHoverBrush" Color="#DCE5F0" />
          <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1D4ED8" />
          <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
          <SolidColorBrush x:Key="SuccessSoftBrush" Color="#ECFDF5" />
          <SolidColorBrush x:Key="SuccessBorderBrush" Color="#A7F3D0" />
          <SolidColorBrush x:Key="SuccessTextBrush" Color="#047857" />
          <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2" />
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#FECACA" />
          <SolidColorBrush x:Key="DangerTextBrush" Color="#991B1B" />
          <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
          <SolidColorBrush x:Key="ChangedSoftBrush" Color="#FFF4CC" />
          <SolidColorBrush x:Key="ChangedBorderBrush" Color="#F59E0B" />
          <SolidColorBrush x:Key="ChangedTextBrush" Color="#92400E" />
          <SolidColorBrush x:Key="SidebarDarkBrush" Color="#E8ECF0" />
          <SolidColorBrush x:Key="SidebarDarkAltBrush" Color="#E8ECF0" />
          <SolidColorBrush x:Key="SidebarBorderBrush" Color="#ABB7C6" />
          <SolidColorBrush x:Key="SidebarTextBrush" Color="#172033" />
          <SolidColorBrush x:Key="SidebarTextMutedBrush" Color="#536279" />
          <SolidColorBrush x:Key="NodeBackgroundBrush" Color="#F1F3F5" />
          <SolidColorBrush x:Key="NodeHeaderBrush" Color="#EEF3FF" />
          <SolidColorBrush x:Key="NodeConnectorTextBrush" Color="#3B465C" />
          <SolidColorBrush x:Key="NodeNeutralBrush" Color="#C9D8F6" />
          <SolidColorBrush x:Key="NodeStartBrush" Color="#C9D8F6" />
          <SolidColorBrush x:Key="NodeModbusBrush" Color="#AFCBFF" />
          <SolidColorBrush x:Key="NodeRangeBrush" Color="#BFD2F8" />
          <SolidColorBrush x:Key="NodeDelayBrush" Color="#BFD2F8" />
          <SolidColorBrush x:Key="NodeHttpBrush" Color="#BFD2F8" />
          <SolidColorBrush x:Key="NodeLoopBrush" Color="#BFD2F8" />
          <SolidColorBrush x:Key="NodeEqualityBrush" Color="#BFD2F8" />
          <SolidColorBrush x:Key="NodeWaitBrush" Color="#BFD2F8" />
          <SolidColorBrush x:Key="NodePollBrush" Color="#BFD2F8" />
          <SolidColorBrush x:Key="NodeOperatorBrush" Color="#BFD2F8" />
          <SolidColorBrush x:Key="ConnectorFillBrush" Color="#E0F2FE" />
          <SolidColorBrush x:Key="ConnectorStrokeBrush" Color="#0284C7" />
          <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#F1F3F5" />
          <SolidColorBrush x:Key="SystemControlBackgroundAltMediumHighBrush" Color="#F1F3F5" />
          <SolidColorBrush x:Key="SystemControlBackgroundBaseHighBrush" Color="#F1F3F5" />
          <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumHighBrush" Color="#F8FAFC" />
          <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="#F8FAFC" />
          <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#0F172A" />
          <SolidColorBrush x:Key="SystemControlForegroundBaseMediumHighBrush" Color="#334155" />
          <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#64748B" />
          <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#2563EB" />
          <SolidColorBrush x:Key="Node.BackgroundBrush" Color="#F1F3F5" />
          <SolidColorBrush x:Key="Node.ForegroundBrush" Color="#172033" />
          <SolidColorBrush x:Key="Node.BorderBrush" Color="#AFCBFF" />
          <SolidColorBrush x:Key="ForegroundBrush" Color="#172033" />
          <SolidColorBrush x:Key="NodifyEditor.SelectionRectangleStrokeBrush" Color="#2563EB" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#20252D" />
          <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#232A33" />
          <SolidColorBrush x:Key="EditorDotBrush" Color="#526171" />
          <SolidColorBrush x:Key="InactiveNodeBackgroundBrush" Color="#555555" />
          <SolidColorBrush x:Key="InactiveNodeFieldBrush" Color="#626262" />
          <SolidColorBrush x:Key="GridLineBrush" Color="#343F4C" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#2C3440" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#262E38" />
          <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#364150" />
          <SolidColorBrush x:Key="SurfacePressedBrush" Color="#425165" />
          <SolidColorBrush x:Key="BorderBrush" Color="#58677C" />
          <SolidColorBrush x:Key="BorderStrongBrush" Color="#7D90A8" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E3E8F0" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BFCBDC" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#AFBED2" />
          <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6" />
          <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#60A5FA" />
          <SolidColorBrush x:Key="PrimarySoftBrush" Color="#1E3A5F" />
          <SolidColorBrush x:Key="ProfileSelectedBrush" Color="#254F7F" />
          <SolidColorBrush x:Key="PrimarySoftHoverBrush" Color="#1E3554" />
          <SolidColorBrush x:Key="PrimaryTextBrush" Color="#93C5FD" />
          <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
          <SolidColorBrush x:Key="SuccessSoftBrush" Color="#153927" />
          <SolidColorBrush x:Key="SuccessBorderBrush" Color="#276749" />
          <SolidColorBrush x:Key="SuccessTextBrush" Color="#86EFAC" />
          <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#3F1D25" />
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#7F2A36" />
          <SolidColorBrush x:Key="DangerTextBrush" Color="#FCA5A5" />
          <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
          <SolidColorBrush x:Key="ChangedSoftBrush" Color="#493512" />
          <SolidColorBrush x:Key="ChangedBorderBrush" Color="#FBBF24" />
          <SolidColorBrush x:Key="ChangedTextBrush" Color="#FDE68A" />
          <SolidColorBrush x:Key="SidebarDarkBrush" Color="#2C3440" />
          <SolidColorBrush x:Key="SidebarDarkAltBrush" Color="#2C3440" />
          <SolidColorBrush x:Key="SidebarBorderBrush" Color="#58677C" />
          <SolidColorBrush x:Key="SidebarTextBrush" Color="#E5ECF7" />
          <SolidColorBrush x:Key="SidebarTextMutedBrush" Color="#BFCBDC" />
          <SolidColorBrush x:Key="NodeBackgroundBrush" Color="#2C3440" />
          <SolidColorBrush x:Key="NodeHeaderBrush" Color="#394A63" />
          <SolidColorBrush x:Key="NodeConnectorTextBrush" Color="#C7D2E5" />
          <SolidColorBrush x:Key="NodeNeutralBrush" Color="#4A6BA7" />
          <SolidColorBrush x:Key="NodeStartBrush" Color="#4A6BA7" />
          <SolidColorBrush x:Key="NodeModbusBrush" Color="#5B8EF1" />
          <SolidColorBrush x:Key="NodeRangeBrush" Color="#4A6BA7" />
          <SolidColorBrush x:Key="NodeDelayBrush" Color="#4A6BA7" />
          <SolidColorBrush x:Key="NodeHttpBrush" Color="#4A6BA7" />
          <SolidColorBrush x:Key="NodeLoopBrush" Color="#4A6BA7" />
          <SolidColorBrush x:Key="NodeEqualityBrush" Color="#4A6BA7" />
          <SolidColorBrush x:Key="NodeWaitBrush" Color="#4A6BA7" />
          <SolidColorBrush x:Key="NodePollBrush" Color="#4A6BA7" />
          <SolidColorBrush x:Key="NodeOperatorBrush" Color="#4A6BA7" />
          <SolidColorBrush x:Key="ConnectorFillBrush" Color="#123554" />
          <SolidColorBrush x:Key="ConnectorStrokeBrush" Color="#38BDF8" />
          <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#2C3440" />
          <SolidColorBrush x:Key="SystemControlBackgroundAltMediumHighBrush" Color="#2C3440" />
          <SolidColorBrush x:Key="SystemControlBackgroundBaseHighBrush" Color="#2C3440" />
          <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumHighBrush" Color="#262E38" />
          <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="#262E38" />
          <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#E5ECF7" />
          <SolidColorBrush x:Key="SystemControlForegroundBaseMediumHighBrush" Color="#C7D2E5" />
          <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#A9B5C8" />
          <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#3B82F6" />
          <SolidColorBrush x:Key="Node.BackgroundBrush" Color="#2C3440" />
          <SolidColorBrush x:Key="Node.ForegroundBrush" Color="#E5ECF7" />
          <SolidColorBrush x:Key="Node.BorderBrush" Color="#5B8EF1" />
          <SolidColorBrush x:Key="ForegroundBrush" Color="#E5ECF7" />
          <SolidColorBrush x:Key="NodifyEditor.SelectionRectangleStrokeBrush" Color="#60A5FA" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Button.workspaceNav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.workspaceNav.active">
    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
  </Style>

  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="{StaticResource FontTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="{StaticResource FontSection}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Padding" Value="{StaticResource PanelInset}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="WrapPanel.actions > Button">
    <Setter Property="Margin" Value="0,0,8,8" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="{StaticResource ControlInset}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>

  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
  </Style>

  <Style Selector="Button.primary PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
  </Style>

  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource PrimarySoftHoverBrush}" />
  </Style>

  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="TabControl">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
  </Style>

  <Style Selector="nodify|NodifyEditor">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="nodify|Node">
    <Setter Property="Background" Value="{DynamicResource NodeBackgroundBrush}" />
    <Setter Property="ContentBrush" Value="{DynamicResource NodeBackgroundBrush}" />
    <Setter Property="HeaderBrush" Value="{DynamicResource NodeHeaderBrush}" />
    <Setter Property="FooterBrush" Value="{DynamicResource NodeBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NodeNeutralBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="nodify|NodeInput">
    <Setter Property="Foreground" Value="{DynamicResource NodeConnectorTextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="3,2" />
  </Style>

  <Style Selector="nodify|NodeOutput">
    <Setter Property="Foreground" Value="{DynamicResource NodeConnectorTextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="3,2" />
  </Style>

  <Style Selector="nodify|NodeInput:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
  </Style>

  <Style Selector="nodify|NodeOutput:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
  </Style>

  <Style Selector="nodify|Node.ModbusNode">
    <Setter Property="BorderBrush" Value="{DynamicResource NodeModbusBrush}" />
  </Style>

  <Style Selector="nodify|Node.RangeNode">
    <Setter Property="BorderBrush" Value="{DynamicResource NodeRangeBrush}" />
  </Style>

  <Style Selector="nodify|Node.DelayNode">
    <Setter Property="BorderBrush" Value="{DynamicResource NodeDelayBrush}" />
  </Style>

  <Style Selector="nodify|Node.HttpNode">
    <Setter Property="BorderBrush" Value="{DynamicResource NodeHttpBrush}" />
  </Style>

  <Style Selector="nodify|Node.LabelNode">
    <Setter Property="BorderBrush" Value="{DynamicResource NodeNeutralBrush}" />
  </Style>

  <Style Selector="nodify|Node.LoopNode">
    <Setter Property="BorderBrush" Value="{DynamicResource NodeLoopBrush}" />
  </Style>

  <Style Selector="nodify|Node.EqualityNode">
    <Setter Property="BorderBrush" Value="{DynamicResource NodeEqualityBrush}" />
  </Style>

  <Style Selector="nodify|Node.WaitNode">
    <Setter Property="BorderBrush" Value="{DynamicResource NodeWaitBrush}" />
  </Style>

  <Style Selector="nodify|Node.PollNode">
    <Setter Property="BorderBrush" Value="{DynamicResource NodePollBrush}" />
  </Style>

  <Style Selector="nodify|Node.OperatorNode">
    <Setter Property="BorderBrush" Value="{DynamicResource NodeOperatorBrush}" />
  </Style>


  <Style Selector="Button.listHeader, Button.edgeHandle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,10" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.listHeader:pointerover, Button.edgeHandle:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
  </Style>
  <Style Selector="Button.listHeader:focus-visible, Button.edgeHandle:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
  </Style>
  <Style Selector="Border.nodeEntry">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.nodeEntry:pointerover">
    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
  </Style>

  <Style Selector="Button.sidebarAction">
    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="Button.sidebarAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ProfileSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
  </Style>
  <Style Selector="Border.profileSidebar ComboBox, Border.profileSidebar TextBox">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Border.profileSidebar Button.listHeader">
    <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
</Styles>
