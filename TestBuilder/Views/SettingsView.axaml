<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             x:Name="SettingsRoot" x:Class="TestBuilder.Views.SettingsView" x:DataType="vm:SettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
    <StackPanel Margin="16" Spacing="16" MaxWidth="800" HorizontalAlignment="Stretch">
      <TextBlock Text="Настройки" Classes="pageTitle" />
      <TextBlock Text="{Binding ProfileContext}" TextWrapping="Wrap" />
      <Button Content="Полная инструкция" Click="OnOpenUserGuide" AutomationProperties.Name="Открыть полную инструкцию" />
      <Button Content="Интерактивное обучение" Click="OnOpenTutorial" IsEnabled="{Binding CanStartTutorial}" AutomationProperties.Name="Пройти интерактивное обучение" />
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Text="Подключения рабочего места" Classes="sectionTitle" />
          <TextBlock Text="COM стенда (пусто — автоматически)" TextWrapping="Wrap" />
          <TextBox Text="{Binding StandPort}" Watermark="Например, COM3" />
          <Button Content="Параметры открытия COM-порта…" Command="{Binding ConfigureDiscoveryCommand}"/>
          <TextBlock Text="COM консоли (отдельный USB-UART)" IsVisible="{Binding ShowConsoleSettings}" />
          <TextBox Text="{Binding ConsolePort}" Watermark="COM4" IsVisible="{Binding ShowConsoleSettings}" />
          <TextBlock Text="Резервные порты для старых профилей. Для новых задайте подключения через «Оборудование» — они сохранятся в JSON профиля." TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Text="Рабочий режим" Classes="sectionTitle" />
          <WrapPanel>
            <RadioButton Content="Пульт стенда" GroupName="{Binding #SettingsRoot.WorkspaceModeGroupName}"
                         IsChecked="{Binding !IsEngineerMode, Mode=TwoWay}" Margin="0,0,24,0" />
            <RadioButton Content="Инженерный режим" GroupName="{Binding #SettingsRoot.WorkspaceModeGroupName}"
                         IsChecked="{Binding IsEngineerMode, Mode=TwoWay}" />
          </WrapPanel>
          <TextBlock Text="Оформление" />
          <WrapPanel>
            <RadioButton Content="Светлое" GroupName="{Binding #SettingsRoot.ThemeGroupName}" IsChecked="{Binding !IsDarkTheme}" Margin="0,0,24,0" />
            <RadioButton Content="Тёмное" GroupName="{Binding #SettingsRoot.ThemeGroupName}" IsChecked="{Binding IsDarkTheme}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Text="Профили тестирования" Classes="sectionTitle" />
          <TextBlock Text="Папка с JSON-профилями" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding GraphsFolder}" IsReadOnly="True" Watermark="Папка не выбрана" MinWidth="240" />
            <Button Grid.Column="1" Content="Выбрать папку" Command="{Binding SelectFolderCommand}" Margin="8,0,0,0" />
          </Grid>
          <TextBlock Text="Профили из этой папки доступны в пульте и редакторе тестов." Classes="hint" />
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Text="Сервер и стенд" Classes="sectionTitle" />
          <TextBlock Text="Адрес сервера" />
          <TextBox Text="{Binding ServerBaseUrl}" Watermark="Адрес сервера" />
          <TextBlock Text="Используется для получения серийного номера и отправки отчёта в профилях с SERVER_BASE_URL." Classes="hint" />
          <TextBlock Text="Идентификатор стенда" />
          <TextBox Text="{Binding StandId}" Watermark="тест" />
          <TextBlock Text="Задаётся вручную и попадает в отчёт. По умолчанию — «тест»." Classes="hint" />
        </StackPanel>
      </Border>
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Text="Журнал выполнения" Classes="sectionTitle" />
          <CheckBox IsChecked="{Binding EnableFileLogging}">
            <TextBlock Text="Сохранять журнал каждого запуска в файл" TextWrapping="Wrap" />
          </CheckBox>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding LogFolder}" IsReadOnly="True" Watermark="Папка не выбрана" />
            <Button Grid.Column="1" Content="Выбрать папку" Command="{Binding SelectLogFolderCommand}" Margin="8,0,0,0" />
          </Grid>
          <TextBlock Text="В журнал входят сообщения приложения и обмен со стендом по Modbus." Classes="hint" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
