<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels" xmlns:views="using:TestBuilder.Views" x:Class="TestBuilder.Views.LabelPrintingView"
             x:DataType="vm:LabelPrintingViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch">
      <TextBlock Text="Проверка печати этикетки" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Печать на принтере Windows без запуска графа и подключения стенда." TextWrapping="Wrap" />
      <Border Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}">
        <Grid ColumnDefinitions="*,16,Auto">
        <StackPanel Spacing="8">
          <TextBlock Text="Последний тест" FontWeight="SemiBold" />
          <SelectableTextBlock Text="{Binding LastTestDescription}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LastTestResult}" TextWrapping="Wrap" IsVisible="{Binding HasLastTest}" />
          <TextBlock Text="{Binding LastTestMessage}" TextWrapping="Wrap" IsVisible="{Binding HasLastTest}" />
          <Button x:Name="PrintLastTestButton" Content="Печатать из последнего теста" Command="{Binding PrintLastTestCommand}"
                  ToolTip.Tip="Данные и шаблон берутся из последнего теста. Принтер и количество — из полей ниже." />
        </StackPanel>
        <views:LabelPreviewControl Grid.Column="2" Preview="{Binding LastTestPreview}" IsVisible="{Binding HasLastTestLabel}" Height="110" Width="260" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <StackPanel Spacing="12" IsEnabled="{Binding CanEdit}">
        <StackPanel Spacing="8" IsVisible="{Binding ShowProductPicker}">
          <TextBlock Text="Изделие" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto">
            <ComboBox x:Name="LabelProductPicker" ItemsSource="{Binding ProductNames}" SelectedItem="{Binding SelectedProductName, Mode=TwoWay}"
                      PlaceholderText="Выберите изделие" HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Content="Обновить изделия" Command="{Binding RefreshProductsCommand}" Margin="12,0,0,0" />
          </Grid>
          <TextBlock Text="В профилях нет названий изделий. Укажите изделие в редакторе профиля." IsVisible="{Binding !HasProducts}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{Binding ProfileDeviceName}" IsVisible="{Binding !ShowProductPicker}" FontWeight="SemiBold" />
        <TextBlock Text="Выберите этикетку" FontWeight="SemiBold" />
        <ListBox x:Name="LabelTemplatePicker" ItemsSource="{Binding LabelOptions}" SelectedIndex="{Binding SelectedType}"
                 Background="Transparent" Padding="0" MaxHeight="320" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,8,8"/>
              <Setter Property="BorderThickness" Value="2"/><Setter Property="CornerRadius" Value="8"/>
              <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            </Style>
            <Style Selector="ListBoxItem:selected">
              <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LabelTemplatePreviewItem">
              <StackPanel Width="240" Spacing="8" ToolTip.Tip="{Binding Preview.Message}">
                <views:LabelPreviewControl Preview="{Binding Preview}" Height="106" IsHitTestVisible="False" />
                <TextBlock Text="Предпросмотр недоступен" IsVisible="{Binding !Preview.HasContent}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Настроить шаблоны…" Command="{Binding EditTemplatesCommand}"/>
        <Grid x:Name="LabelDetailsGrid" ColumnDefinitions="*,24,400">
        <StackPanel Spacing="12">
        <TextBlock Text="Серийный номер" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="LabelSerialInput" Text="{Binding SerialNumber}" Watermark="Для поиска — полный серверный номер" MinWidth="320" />
          <Button Grid.Column="1" Content="Получить по серийнику" Command="{Binding FindBySerialCommand}" Margin="12,0,0,0" />
        </Grid>
        <TextBlock Text="MAC-адрес" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="LabelMacInput" Text="{Binding MacAddress}" Watermark="C0:11:A6:20:01:AC" />
          <Button Grid.Column="1" Content="Получить по MAC" Command="{Binding FindByMacCommand}" Margin="12,0,0,0" />
        </Grid>
        <TextBlock Text="Выбранный шаблон не требует MAC." IsVisible="{Binding !HasMac}" />
        <TextBlock Text="Принтер" />
        <views:PrinterPicker PrinterName="{Binding PrinterName, Mode=TwoWay}" />
        <Grid ColumnDefinitions="Auto,Auto">
          <TextBlock Text="Количество этикеток" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Value="{Binding Copies}" Minimum="1" Maximum="100" Increment="1" FormatString="0" Width="120" Margin="12,0,0,0" />
        </Grid>
        </StackPanel>
        <Border x:Name="PreviewPanel" Grid.Column="2" Padding="16" VerticalAlignment="Top" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}">
          <StackPanel Spacing="8">
            <TextBlock Text="Предпросмотр" FontWeight="SemiBold"/>
            <views:LabelPreviewControl x:Name="CurrentLabelPreview" Preview="{Binding Preview}" Height="190" MaxWidth="560" HorizontalAlignment="Stretch" IsVisible="{Binding Preview.HasContent}"/>
            <TextBlock Text="{Binding Preview.Message}" IsVisible="{Binding Preview.HasMessage}" TextWrapping="Wrap"/>
            <TextBlock Text="Приблизительный вид. Точные шрифты и поля зависят от принтера." TextWrapping="Wrap" FontSize="12"/>
          </StackPanel>
        </Border>
        </Grid>
      </StackPanel>
      <WrapPanel>
        <Button Content="Печатать" Classes="primary" Command="{Binding PrintCommand}" Margin="0,0,12,8" />
        <Button Content="Повторить последнюю этикетку" Command="{Binding RepeatLastCommand}" Margin="0,0,12,8"
                ToolTip.Tip="Повторяет данные последней успешной печати этой вкладки. Количество и принтер берутся из текущих полей." />
        <Button Content="Отменить" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Margin="0,0,0,8" />
      </WrapPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="16" />
      <TextBlock Text="Последняя этикетка этой вкладки" FontWeight="SemiBold" />
      <SelectableTextBlock Text="{Binding LastLabelDescription}" TextWrapping="Wrap" />
      <views:LabelPreviewControl x:Name="LastLabelPreview" Preview="{Binding LastPreview}" IsVisible="{Binding HasLastPreview}" Height="130" Width="340" HorizontalAlignment="Left"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
