<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             x:Class="TestBuilder.Views.NetworkSetupView"
             x:DataType="vm:NetworkSetupViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16" Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
      <TextBlock Text="Сеть стенда" Classes="pageTitle"/>
      <TextBlock Text="Статический IPv4 /24, без шлюза. Для применения нужны права администратора."
                 TextWrapping="Wrap" Opacity="0.7"/>
      <Grid ColumnDefinitions="70,110,145,*" Margin="0,8,0,0">
        <TextBlock Grid.Column="0" Text="Порт" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="1" Text="PSW-2G6F+" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="2" Text="Адрес" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="3" Text="Сетевая карта" FontWeight="SemiBold"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NetworkSetupRowViewModel">
            <Grid ColumnDefinitions="70,110,145,*" Margin="0,0,0,8">
              <TextBlock Grid.Column="0" Text="{Binding Port}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Psw2G6FPort}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding Ip}" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding Adapters}"
                        SelectedItem="{Binding SelectedAdapter}"
                        >
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" ToolTip.Tip="{Binding Display}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <WrapPanel Classes="actions" Margin="0,8,0,0">
        <Button Content="Обновить список" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}"/>
        <Button Content="Подобрать для PSW-2G6F+" Command="{Binding SuggestPsw2G6FCommand}" IsEnabled="{Binding !IsBusy}"/>
        <Button Content="Применить адреса" Command="{Binding ApplyCommand}" IsEnabled="{Binding !IsBusy}"/>
      </WrapPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
