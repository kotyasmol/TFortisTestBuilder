<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels" xmlns:views="using:TestBuilder.Views"
             xmlns:converters="using:TestBuilder.Converters"
             xmlns:avaloniaConverters="using:Avalonia.Data.Converters"
             x:Class="TestBuilder.Views.ProfileActionBar" x:DataType="vm:TestViewModel" Background="{DynamicResource SurfaceBrush}">
  <UserControl.Resources>
    <converters:ContrastTextConverter x:Key="ContrastText" />
    <ControlTheme x:Key="ActionButtonTheme" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template"><ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter Background="Transparent" Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate></Setter>
      <Style Selector="^:pointerover"><Setter Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" /></Style>
      <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.85" /></Style>
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.profileAction:not(.systemColor)" x:DataType="vm:ProfileActionViewModel">
      <Setter Property="Background" Value="{Binding Background}" />
    </Style>
    <Style Selector="Button.profileAction.systemColor">
      <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="QuickActionsLayout" ColumnDefinitions="Auto,24" IsVisible="{Binding ShowQuickActions}">
    <Border x:Name="QuickActionsPanel" IsVisible="{Binding !IsQuickActionsCollapsed}" Width="280" Padding="12"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12" IsVisible="{Binding ShowQuickActionHeader}">
          <TextBlock Text="Кнопки профиля" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="+" FontSize="22" Width="36" Padding="4" VerticalAlignment="Center"
                  Command="{Binding AddQuickActionCommand}" IsVisible="{Binding ShowQuickActionTools}"
                  ToolTip.Tip="Добавить кнопку в профиль" AutomationProperties.Name="Добавить кнопку в профиль" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16">
          <ItemsControl ItemsSource="{Binding QuickActions}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileActionViewModel">
                <Grid>
                  <Button x:Name="ActionRunButton" Classes="profileAction" Classes.systemColor="{Binding UsesSystemColor}" Theme="{StaticResource ActionButtonTheme}" Command="{Binding RunCommand}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="70" Padding="10,8,42,8"
                          ToolTip.Tip="{Binding DetailText}" AutomationProperties.Name="{Binding Name}">
                    <Button.Foreground>
                      <MultiBinding Converter="{StaticResource ContrastText}">
                        <Binding Path="Background" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="$parent[views:ProfileActionBar].Background" />
                      </MultiBinding>
                    </Button.Foreground>
                    <Grid ColumnDefinitions="Auto,*">
                      <Grid Width="34" Height="26" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border IsVisible="{Binding IsToggle}" Width="34" Height="20" CornerRadius="10" BorderThickness="2" BorderBrush="{Binding $parent[Button].Foreground}">
                          <Ellipse Fill="{Binding $parent[Button].Foreground}" Width="10" Height="10" Margin="3,0" HorizontalAlignment="Left" Opacity="{Binding ToggleOpacity}">
                            <Ellipse.RenderTransform>
                              <TranslateTransform X="{Binding ToggleOffset}">
                                <TranslateTransform.Transitions>
                                  <Transitions><DoubleTransition Property="X" Duration="0:0:0.35" Easing="CubicEaseInOut" /></Transitions>
                                </TranslateTransform.Transitions>
                              </TranslateTransform>
                            </Ellipse.RenderTransform>
                          </Ellipse>
                        </Border>
                        <views:ActionActivityIndicator Width="26" Height="26" IsActive="{Binding IsRunning}" Progress="{Binding Progress}" IsVisible="{Binding ShowProgress}" Stroke="{Binding $parent[Button].Foreground}" />
                      </Grid>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Foreground="{Binding $parent[Button].Foreground}" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Foreground="{Binding $parent[Button].Foreground}" Text="{Binding StateText}" FontSize="11" Height="16" MaxLines="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <!-- Siblings avoid nested run clicks; the transparent guard also intercepts clicks on disabled tools. -->
                  <Grid Width="28" Height="58" Margin="0,6,6,6" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent">
                    <Grid.IsVisible>
                      <MultiBinding Converter="{x:Static avaloniaConverters:BoolConverters.Or}">
                        <Binding Path="IsRunning" />
                        <Binding Path="$parent[views:ProfileActionBar].((vm:TestViewModel)DataContext).ShowQuickActionTools" />
                      </MultiBinding>
                    </Grid.IsVisible>
                    <Button Content="■" Classes="profileCardTool" Theme="{StaticResource ProfileCardToolTheme}" VerticalAlignment="Center" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" ToolTip.Tip="Остановить действие" AutomationProperties.Name="Остановить действие" />
                    <Grid IsVisible="{Binding $parent[views:ProfileActionBar].((vm:TestViewModel)DataContext).ShowQuickActionTools}">
                      <StackPanel Spacing="2" IsVisible="{Binding !IsRunning}">
                        <Button Classes="profileCardTool" Theme="{StaticResource ProfileCardToolTheme}"
                                ToolTip.Tip="Изменить кнопку" AutomationProperties.Name="Изменить кнопку"
                                Command="{Binding $parent[views:ProfileActionBar].((vm:TestViewModel)DataContext).EditQuickActionCommand}" CommandParameter="{Binding}">
                          <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                              <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2.4" StrokeJoin="Round"
                                    Data="M10 2 H14 L14.7 5.1 L16.1 5.9 L19.1 5 L21.1 8.5 L18.8 10.7 V13.3 L21.1 15.5 L19.1 19 L16.1 18.1 L14.7 18.9 L14 22 H10 L9.3 18.9 L7.9 18.1 L4.9 19 L2.9 15.5 L5.2 13.3 V10.7 L2.9 8.5 L4.9 5 L7.9 5.9 L9.3 5.1 Z" />
                              <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2.4" />
                            </Canvas>
                          </Viewbox>
                        </Button>
                        <Button Classes="profileCardTool" Theme="{StaticResource ProfileCardToolTheme}"
                                ToolTip.Tip="Удалить кнопку" AutomationProperties.Name="Удалить кнопку"
                                Command="{Binding $parent[views:ProfileActionBar].((vm:TestViewModel)DataContext).DeleteQuickActionCommand}" CommandParameter="{Binding}">
                          <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                              <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2.4" StrokeLineCap="Round" Data="M2 2 L22 22 M22 2 L2 22" />
                            </Canvas>
                          </Viewbox>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
    <Button Grid.Column="1" x:Name="QuickActionsHandle" Classes="edgeHandle" Command="{Binding ToggleQuickActionsCommand}"
            ToolTip.Tip="{Binding QuickActionsToggleTip}" AutomationProperties.Name="Свернуть или развернуть кнопки профиля"
            Width="24" MinWidth="24" Height="64" Padding="5,12" VerticalAlignment="Center">
      <Grid x:Name="QuickActionsArrows" RenderTransformOrigin="50%,50%">
        <PathIcon Width="10" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsQuickActionsCollapsed}" Data="M2 0 L10 8 2 16 0 14 6 8 0 2 Z" />
        <PathIcon Width="10" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding !IsQuickActionsCollapsed}" Data="M8 0 L0 8 8 16 10 14 4 8 10 2 Z" />
      </Grid>
    </Button>
  </Grid>
</UserControl>
