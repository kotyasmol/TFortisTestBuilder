<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels" xmlns:views="using:TestBuilder.Views"
             x:Class="TestBuilder.Views.ProfileActionBar" x:DataType="vm:TestViewModel">
  <UserControl.Resources>
    <ControlTheme x:Key="ActionButtonTheme" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter Background="Transparent" Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate></Setter>
      <Style Selector="^:pointerover"><Setter Property="Opacity" Value="0.9" /></Style>
      <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.75" /></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.7" /></Style>
    </ControlTheme>
  </UserControl.Resources>
  <Border IsVisible="{Binding ShowQuickActions}" Padding="12,6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
    <DockPanel LastChildFill="True">
      <Button DockPanel.Dock="Right" Content="+" FontSize="22" Width="42" Margin="8,0,0,0" VerticalAlignment="Center"
              Command="{Binding AddQuickActionCommand}" IsVisible="{Binding ShowQuickActionTools}"
              ToolTip.Tip="Добавить кнопку в профиль" AutomationProperties.Name="Добавить кнопку в профиль" />
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding QuickActions}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileActionViewModel">
              <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                <Button Classes="profileAction" Theme="{StaticResource ActionButtonTheme}" Command="{Binding RunCommand}" Background="{Binding Background}" Foreground="{Binding Foreground}"
                        MinWidth="160" MaxWidth="340" Padding="12,6" ToolTip.Tip="{Binding StateText}" AutomationProperties.Name="{Binding Name}">
                  <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                      <Border IsVisible="{Binding IsToggle}" Width="34" Height="20" CornerRadius="10" BorderThickness="2" BorderBrush="{Binding Foreground}">
                        <Ellipse Fill="{Binding Foreground}" Width="10" Height="10" Margin="3,0" HorizontalAlignment="{Binding ToggleAlignment}" Opacity="{Binding ToggleOpacity}" />
                      </Border>
                      <views:ActionActivityIndicator Width="26" Height="26" IsActive="{Binding IsRunning}" Progress="{Binding Progress}" IsVisible="{Binding ShowProgress}" Stroke="{Binding Foreground}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Foreground="{Binding Foreground}" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Foreground="{Binding Foreground}" Text="{Binding StateText}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Content="■" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" ToolTip.Tip="Остановить действие" AutomationProperties.Name="Остановить действие" />
                <StackPanel VerticalAlignment="Center" Spacing="2" IsVisible="{Binding $parent[views:ProfileActionBar].((vm:TestViewModel)DataContext).ShowQuickActionTools}">
                  <Button Content="⚙" Padding="6,2" MinHeight="24" ToolTip.Tip="Изменить кнопку" AutomationProperties.Name="Изменить кнопку"
                          Command="{Binding $parent[views:ProfileActionBar].((vm:TestViewModel)DataContext).EditQuickActionCommand}" CommandParameter="{Binding}" />
                  <Button Content="×" Padding="6,2" MinHeight="24" ToolTip.Tip="Удалить кнопку" AutomationProperties.Name="Удалить кнопку"
                          Command="{Binding $parent[views:ProfileActionBar].((vm:TestViewModel)DataContext).DeleteQuickActionCommand}" CommandParameter="{Binding}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
