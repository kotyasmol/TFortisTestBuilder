<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels" xmlns:views="using:TestBuilder.Views"
             x:Class="TestBuilder.Views.ProfileActionBar" x:DataType="vm:TestViewModel">
  <UserControl.Resources>
    <ControlTheme x:Key="ActionButtonTheme" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter Background="Transparent" Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate></Setter>
      <Style Selector="^:pointerover"><Setter Property="Opacity" Value="0.9" /></Style>
      <Style Selector="^:pressed"><Setter Property="Opacity" Value="0.75" /></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.7" /></Style>
    </ControlTheme>
  </UserControl.Resources>
  <Grid x:Name="QuickActionsLayout" ColumnDefinitions="Auto,24" IsVisible="{Binding ShowQuickActions}">
    <Border x:Name="QuickActionsPanel" IsVisible="{Binding !IsQuickActionsCollapsed}" Width="280" Padding="12"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <TextBlock Text="Кнопки профиля" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="+" FontSize="22" Width="36" Padding="4" VerticalAlignment="Center"
                  Command="{Binding AddQuickActionCommand}" IsVisible="{Binding ShowQuickActionTools}"
                  ToolTip.Tip="Добавить кнопку в профиль" AutomationProperties.Name="Добавить кнопку в профиль" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding QuickActions}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileActionViewModel">
                <Grid ColumnDefinitions="*,Auto">
                  <Button Classes="profileAction" Theme="{StaticResource ActionButtonTheme}" Command="{Binding RunCommand}" Background="{Binding Background}" Foreground="{Binding Foreground}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="52" Padding="10,8"
                          ToolTip.Tip="{Binding StateText}" AutomationProperties.Name="{Binding Name}">
                    <Grid ColumnDefinitions="Auto,*">
                      <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border IsVisible="{Binding IsToggle}" Width="34" Height="20" CornerRadius="10" BorderThickness="2" BorderBrush="{Binding Foreground}">
                          <Ellipse Fill="{Binding Foreground}" Width="10" Height="10" Margin="3,0" HorizontalAlignment="{Binding ToggleAlignment}" Opacity="{Binding ToggleOpacity}" />
                        </Border>
                        <views:ActionActivityIndicator Width="26" Height="26" IsActive="{Binding IsRunning}" Progress="{Binding Progress}" IsVisible="{Binding ShowProgress}" Stroke="{Binding Foreground}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Foreground="{Binding Foreground}" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Foreground="{Binding Foreground}" Text="{Binding StateText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <Button Content="■" Margin="4,0,0,0" Padding="6,2" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" ToolTip.Tip="Остановить действие" AutomationProperties.Name="Остановить действие" />
                    <StackPanel Margin="4,0,0,0" Spacing="2" IsVisible="{Binding $parent[views:ProfileActionBar].((vm:TestViewModel)DataContext).ShowQuickActionTools}">
                      <Button Width="32" Height="28" MinWidth="32" MinHeight="28" Padding="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              ToolTip.Tip="Изменить кнопку" AutomationProperties.Name="Изменить кнопку"
                              Command="{Binding $parent[views:ProfileActionBar].((vm:TestViewModel)DataContext).EditQuickActionCommand}" CommandParameter="{Binding}">
                        <Viewbox Width="16" Height="16">
                          <Canvas Width="24" Height="24">
                            <Path Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.8" StrokeJoin="Round"
                                  Data="M10 2 H14 L14.7 5.1 L16.1 5.9 L19.1 5 L21.1 8.5 L18.8 10.7 V13.3 L21.1 15.5 L19.1 19 L16.1 18.1 L14.7 18.9 L14 22 H10 L9.3 18.9 L7.9 18.1 L4.9 19 L2.9 15.5 L5.2 13.3 V10.7 L2.9 8.5 L4.9 5 L7.9 5.9 L9.3 5.1 Z" />
                            <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.8" />
                          </Canvas>
                        </Viewbox>
                      </Button>
                      <Button Width="32" Height="28" MinWidth="32" MinHeight="28" Padding="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              ToolTip.Tip="Удалить кнопку" AutomationProperties.Name="Удалить кнопку"
                              Command="{Binding $parent[views:ProfileActionBar].((vm:TestViewModel)DataContext).DeleteQuickActionCommand}" CommandParameter="{Binding}">
                        <Viewbox Width="16" Height="16">
                          <Canvas Width="24" Height="24">
                            <Path Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.8" StrokeLineCap="Round" Data="M2 2 L22 22 M22 2 L2 22" />
                          </Canvas>
                        </Viewbox>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
    <Button Grid.Column="1" x:Name="QuickActionsHandle" Classes="edgeHandle" Command="{Binding ToggleQuickActionsCommand}"
            ToolTip.Tip="{Binding QuickActionsToggleTip}" AutomationProperties.Name="Свернуть или развернуть кнопки профиля"
            Width="24" MinWidth="24" Height="64" Padding="5,12" VerticalAlignment="Center">
      <Grid x:Name="QuickActionsArrows" RenderTransformOrigin="50%,50%">
        <PathIcon Width="10" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsQuickActionsCollapsed}" Data="M2 0 L10 8 2 16 0 14 6 8 0 2 Z" />
        <PathIcon Width="10" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding !IsQuickActionsCollapsed}" Data="M8 0 L0 8 8 16 10 14 4 8 10 2 Z" />
      </Grid>
    </Button>
  </Grid>
</UserControl>
