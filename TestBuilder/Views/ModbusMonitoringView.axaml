<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             xmlns:models="using:TestBuilder.Domain.Modbus.Models"
             xmlns:converters="using:TestBuilder.Converters"
             x:Class="TestBuilder.Views.ModbusMonitoringView"
             x:DataType="vm:ModbusMonitoringViewModel">

  <DockPanel Background="{DynamicResource AppBackgroundBrush}">
    <Border DockPanel.Dock="Top"
            Margin="14"
            Padding="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            BoxShadow="0 8 24 0 #100F172A">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Сканировать"
                Classes="primary"
                Command="{Binding ScanCommand}"
                IsEnabled="{Binding !IsScanning}" />

        <Border Background="{DynamicResource DangerSoftBrush}"
                BorderBrush="{DynamicResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,7"
                IsVisible="{Binding !IsConnected}">
          <TextBlock Text="Нет подключения. Подключитесь на вкладке Тест."
                     Foreground="{DynamicResource DangerTextBrush}"
                     VerticalAlignment="Center" />
        </Border>

        <Border Background="{DynamicResource PrimarySoftBrush}"
                BorderBrush="{DynamicResource NodeModbusBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,7"
                IsVisible="{Binding IsScanning}">
          <TextBlock Text="Сканирование..."
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     VerticalAlignment="Center" />
        </Border>

        <Border Background="{DynamicResource SuccessSoftBrush}"
                BorderBrush="{DynamicResource SuccessBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,7"
                IsVisible="{Binding IsMonitoring}">
          <TextBlock Text="Мониторинг запущен"
                     Foreground="{DynamicResource SuccessTextBrush}"
                     VerticalAlignment="Center" />
        </Border>
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Top"
               Text="Устройства не найдены. Подключите железо и нажмите Сканировать."
               IsVisible="{Binding !Slaves.Count}"
               Margin="18,0,18,12"
               Foreground="{DynamicResource TextSecondaryBrush}" />

    <Grid ColumnDefinitions="250,12,*,12,300"
          Margin="14,0,14,14">
      <Border Grid.Column="0"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="12">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="Устройства" FontWeight="SemiBold" FontSize="15"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Slaves.Count, StringFormat='Найдено: {0}'}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Slaves}"
                   SelectedItem="{Binding SelectedSlave}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:SlaveModelBase">
                <Border Padding="10,8" Margin="0,2" CornerRadius="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding DeviceType}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding SlaveId, StringFormat='Slave ID: {0}'}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="12">
        <Grid RowDefinitions="Auto,Auto,*">
          <StackPanel Spacing="2" Margin="0,0,0,12">
            <TextBlock Text="{Binding SelectedSlaveTitle}" FontWeight="SemiBold" FontSize="16"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding SelectedSlaveDetails}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBox Width="220"
                     Text="{Binding RegisterSearch}"
                     Watermark="Поиск: адрес или название" />
            <ComboBox Width="170"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}" />
            <CheckBox Content="Только записываемые"
                      IsChecked="{Binding ShowWritableOnly}"
                      VerticalAlignment="Center" />
            <TextBlock Text="{Binding VisibleRegistersCount, StringFormat='Показано: {0}'}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>

          <DataGrid Grid.Row="2"
                    ItemsSource="{Binding FilteredRegisters}"
                    DoubleTapped="OnDataGridDoubleTapped"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True">
            <DataGrid.Resources>
              <converters:BoolToBackgroundConverter x:Key="BoolToBackground" />
            </DataGrid.Resources>

            <DataGrid.Styles>
              <Style Selector="DataGridRow">
                <Setter Property="Background">
                  <Setter.Value>
                    <Binding Path="IsReadOnly"
                             Converter="{StaticResource BoolToBackground}"
                             x:DataType="models:RegisterItem" />
                  </Setter.Value>
                </Setter>
              </Style>

              <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                <Setter Property="Fill" Value="Transparent" />
              </Style>
            </DataGrid.Styles>

            <DataGrid.Columns>
              <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="90" />
              <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Значение" Binding="{Binding Value, Mode=OneWay}" Width="110" />
              <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="170" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border Grid.Column="4"
              Background="{DynamicResource SidebarDarkBrush}"
              BorderBrush="{DynamicResource SidebarBorderBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="12"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0"
                     Text="Логи Modbus"
                     FontWeight="SemiBold"
                     FontSize="14"
                     Foreground="{DynamicResource SidebarTextBrush}"
                     Margin="0,0,0,8" />

          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding TestingLogger.Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             FontFamily="Consolas"
                             FontSize="11"
                             Foreground="{DynamicResource SidebarTextMutedBrush}"
                             Margin="2,2"
                             TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
