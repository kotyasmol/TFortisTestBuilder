<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             xmlns:models="using:TestBuilder.Domain.Modbus.Models"
             xmlns:converters="using:TestBuilder.Converters"
             xmlns:views="using:TestBuilder.Views"
             xmlns:logging="using:TestBuilder.Services.Logging"
             x:Class="TestBuilder.Views.ModbusMonitoringView"
             x:DataType="vm:ModbusMonitoringViewModel">

  <DockPanel Background="{DynamicResource AppBackgroundBrush}">
    <Border DockPanel.Dock="Top"
            Margin="16"
            Padding="16"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Сканировать"
                Classes="primary"
                Command="{Binding ScanCommand}"
                IsEnabled="{Binding IsConnected}" />

        <Border Background="{DynamicResource DangerSoftBrush}"
                BorderBrush="{DynamicResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,7"
                IsVisible="{Binding !IsConnected}">
          <TextBlock Text="Нет подключения. Подключите стенд в редакторе тестов."
                     Foreground="{DynamicResource DangerTextBrush}"
                     VerticalAlignment="Center" />
        </Border>

        <Border Background="{DynamicResource PrimarySoftBrush}"
                BorderBrush="{DynamicResource NodeModbusBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,7"
                IsVisible="{Binding IsScanning}">
          <TextBlock Text="Сканирование..."
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     VerticalAlignment="Center" />
        </Border>

        <Border Background="{DynamicResource SuccessSoftBrush}"
                BorderBrush="{DynamicResource SuccessBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,7"
                IsVisible="{Binding IsMonitoring}">
          <TextBlock Text="Мониторинг запущен"
                     Foreground="{DynamicResource SuccessTextBrush}"
                     VerticalAlignment="Center" />
        </Border>
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Top"
               Text="Устройства не найдены. Подключите железо и нажмите Сканировать."
               IsVisible="{Binding !Slaves.Count}"
               Margin="18,0,18,12"
               Foreground="{DynamicResource TextSecondaryBrush}" />

    <Grid ColumnDefinitions="220,12,*" RowDefinitions="*,12,180"
          Margin="16,0,16,16">
      <Border Grid.Column="0" Grid.RowSpan="3"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="Устройства" FontWeight="SemiBold" FontSize="{StaticResource FontSection}"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Slaves.Count, StringFormat='Найдено: {0}'}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Slaves}"
                   SelectedItem="{Binding SelectedSlave}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:SlaveModelBase">
                <Border Padding="10,8" Margin="0,2" CornerRadius="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding DeviceType}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding SlaveId, StringFormat='Адрес устройства: {0}'}"
                               FontSize="{StaticResource FontCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12">
        <Grid RowDefinitions="Auto,Auto,*">
          <StackPanel Spacing="2" Margin="0,0,0,12">
            <TextBlock Text="{Binding SelectedSlaveTitle}" FontWeight="SemiBold" FontSize="{StaticResource FontSection}"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding SelectedSlaveDetails}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>

          <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBox Width="220" Margin="0,0,8,8"
                     Text="{Binding RegisterSearch}"
                     Watermark="Поиск: адрес или название" />
            <ComboBox Width="170" Margin="0,0,8,8"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}" />
            <CheckBox Margin="0,0,8,8" Content="Только записываемые"
                      IsChecked="{Binding ShowWritableOnly}"
                      VerticalAlignment="Center" />
            <TextBlock Margin="0,0,8,8" Text="{Binding VisibleRegistersCount, StringFormat='Показано: {0}'}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </WrapPanel>

          <DataGrid Grid.Row="2"
                    ItemsSource="{Binding FilteredRegisters}"
                    DoubleTapped="OnDataGridDoubleTapped"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True">
            <DataGrid.Resources>
              <converters:BoolToBackgroundConverter x:Key="BoolToBackground" />
            </DataGrid.Resources>

            <DataGrid.Styles>
              <Style Selector="DataGridRow">
                <Setter Property="Background">
                  <Setter.Value>
                    <MultiBinding Converter="{StaticResource BoolToBackground}" x:DataType="models:RegisterItem">
                      <Binding Path="IsReadOnly" />
                      <Binding Path="$parent[views:ModbusMonitoringView].ActualThemeVariant" />
                    </MultiBinding>
                  </Setter.Value>
                </Setter>
              </Style>

              <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                <Setter Property="Fill" Value="Transparent" />
              </Style>
            </DataGrid.Styles>

            <DataGrid.Columns>
              <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="90" />
              <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" MinWidth="180" />
              <DataGridTextColumn Header="Значение" Binding="{Binding Value, Mode=OneWay}" Width="110" />
              <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="170" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="2" Grid.Row="1" Height="12" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="Transparent" />
      <Border Grid.Column="2" Grid.Row="2"
              Background="{DynamicResource SidebarDarkBrush}"
              BorderBrush="{DynamicResource SidebarBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="12"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0"
                ColumnDefinitions="*,Auto"
                Margin="0,0,0,8">
            <TextBlock Grid.Column="0"
                       Text="Логи Modbus"
                       FontWeight="SemiBold"
                       FontSize="{StaticResource FontBody}"
                       Foreground="{DynamicResource SidebarTextBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Click="OnCopyLogs"
                    Classes="ghost"
                    Height="28"
                    MinHeight="28"
                    Padding="8,0"
                    FontSize="{StaticResource FontCaption}"
                    Foreground="{DynamicResource SidebarTextMutedBrush}"
                    Content="Копировать"
                    ToolTip.Tip="Копировать выделенные строки; без выделения — весь журнал. Ctrl/⌘+C." />
          </Grid>

          <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding TestingLogger.Entries}"
                   ToolTip.Tip="Shift — диапазон строк, Ctrl/⌘ — отдельные строки. Ctrl/⌘+A — выделить всё."
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="logging:LogEntry">
                  <views:LogEntryView />
                </DataTemplate>
              </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
