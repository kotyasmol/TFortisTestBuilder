<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             x:Class="TestBuilder.Views.SelfTestPageView"
             x:DataType="vm:SelfTestPageViewModel">

  <UserControl.Styles>
    <Style Selector="Button.compactAction">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.categoryHeader">
      <Setter Property="MinHeight" Value="62" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Border.categoryCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BoxShadow" Value="0 5 16 0 #0B0F172A" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.categoryCard.changed">
      <Setter Property="BorderBrush" Value="{DynamicResource ChangedBorderBrush}" />
    </Style>

    <Style Selector="Border.parameterTile">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.parameterTile.changed">
      <Setter Property="Background" Value="{DynamicResource ChangedSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChangedBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Border.parameterTile.changed TextBlock.parameterValue">
      <Setter Property="Foreground" Value="{DynamicResource ChangedTextBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*"
        Margin="12"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Grid.Row="0"
            Padding="16,13"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            BoxShadow="0 8 22 0 #0D0F172A">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Spacing="3"
                    ToolTip.Tip="{Binding SourceUrl}">
          <TextBlock Text="{Binding StatusTitle}"
                     FontSize="19"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{Binding StatusDetails}"
                     MaxLines="1"
                     TextTrimming="CharacterEllipsis"
                     FontSize="14"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Margin="8,0"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center"
                    IsVisible="{Binding HasParameters}">
          <Button Content="Обзор"
                  Classes="compactAction ghost"
                  Command="{Binding ShowMainCommand}"
                  ToolTip.Tip="Открыть все группы, кроме PoE" />
          <Button Content="Развернуть всё"
                  Classes="compactAction ghost"
                  Command="{Binding ExpandAllCommand}" />
          <Button Content="Свернуть всё"
                  Classes="compactAction ghost"
                  Command="{Binding CollapseAllCommand}" />
        </StackPanel>

        <Border Grid.Column="2"
                Padding="13,7"
                VerticalAlignment="Center"
                Background="{DynamicResource PrimarySoftBrush}"
                BorderBrush="{DynamicResource NodeModbusBrush}"
                BorderThickness="1"
                CornerRadius="10"
                IsVisible="{Binding HasParameters}">
          <TextBlock Text="{Binding ParameterCount, StringFormat='Всего: {0}'}"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PrimaryTextBrush}" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Margin="0,10,0,0"
            Padding="7"
            Background="{DynamicResource SurfaceMutedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding HasParameters}">
          <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SelfTestPageCategoryViewModel">
                <Border Width="{Binding CardWidth}"
                        Margin="6"
                        Classes="categoryCard"
                        Classes.changed="{Binding HasRecentChanges}"
                        IsVisible="{Binding HasItems}"
                        VerticalAlignment="Top">
                  <Grid RowDefinitions="Auto,Auto">
                    <Button Grid.Row="0"
                            Classes="categoryHeader"
                            Command="{Binding ToggleCommand}">
                      <Grid ColumnDefinitions="32,*,Auto,Auto">
                        <Border Width="30"
                                Height="30"
                                CornerRadius="9"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding ToggleIcon}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="21"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0"
                                    Spacing="2">
                          <TextBlock Text="{Binding Title}"
                                     FontSize="17"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                          <TextBlock Text="{Binding Description}"
                                     FontSize="12"
                                     MaxLines="1"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                Margin="0,0,10,0"
                                Padding="8,4"
                                CornerRadius="10"
                                Background="{DynamicResource ChangedSoftBrush}"
                                BorderBrush="{DynamicResource ChangedBorderBrush}"
                                BorderThickness="1"
                                IsVisible="{Binding HasRecentChanges}"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding RecentChangeCount, StringFormat='изменено: {0}'}"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource ChangedTextBrush}" />
                        </Border>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding CountLabel}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                      </Grid>
                    </Button>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Parameters}"
                                  IsVisible="{Binding IsExpanded}"
                                  Margin="8,0,8,10">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>

                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SelfTestPageParameterViewModel">
                          <Border Width="{Binding DisplayWidth}"
                                  Height="58"
                                  Margin="3"
                                  Padding="10,7"
                                  Classes="parameterTile"
                                  Classes.changed="{Binding IsChanged}"
                                  ToolTip.Tip="{Binding Value}">
                            <Grid RowDefinitions="Auto,*">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}"
                                         FontSize="12"
                                         MaxLines="1"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />

                                <Border Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="{DynamicResource ChangedBorderBrush}"
                                        IsVisible="{Binding IsChanged}"
                                        ToolTip.Tip="{Binding ChangeDescription}"
                                        VerticalAlignment="Center" />
                              </Grid>

                              <TextBlock Grid.Row="1"
                                         Classes="parameterValue"
                                         Text="{Binding Value}"
                                         MaxLines="1"
                                         TextTrimming="CharacterEllipsis"
                                         FontSize="17"
                                         FontWeight="Bold"
                                         VerticalAlignment="Bottom"
                                         Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6"
                    IsVisible="{Binding !HasParameters}">
          <TextBlock Text="Нет данных тестовой страницы"
                     FontSize="17"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="Панель заполнится автоматически после получения XML от DUT."
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
