<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             xmlns:nodifyvm="using:TestBuilder.ViewModels.NodifyVM"
             x:Class="TestBuilder.Views.TestViews.NodePaletteView"
             x:DataType="vm:TestViewModel">

  <Border CornerRadius="10"
          BorderThickness="1"
          BorderBrush="{DynamicResource SidebarBorderBrush}"
          Background="{DynamicResource SidebarDarkBrush}"
          ClipToBounds="True"
          BoxShadow="0 10 22 0 #0F0F172A">

    <Grid RowDefinitions="Auto,*">

      <Border Grid.Row="0"
              Background="{DynamicResource SidebarDarkAltBrush}"
              Padding="16,14,16,8">

        <StackPanel Spacing="5">
          <TextBlock Text="Ноды"
                     FontSize="16"
                     FontWeight="Bold"
                     Foreground="{DynamicResource SidebarTextBrush}" />

          <TextBlock Text="Перетащи элемент на граф"
                     FontSize="13"
                     Foreground="{DynamicResource SidebarTextMutedBrush}" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

        <ItemsControl ItemsSource="{Binding AvailableNodeCategories}"
                      Margin="12,6,12,12">

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NodePaletteCategoryViewModel">

              <StackPanel Margin="0,8,0,10"
                          Spacing="6">

                <Button Command="{Binding ToggleCommand}"
                        Classes="ghost"
                        Padding="2,2"
                        HorizontalAlignment="Stretch">
                  <TextBlock Text="{Binding Title}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource SidebarTextMutedBrush}" />
                </Button>

                <ItemsControl ItemsSource="{Binding Nodes}"
                              IsVisible="{Binding IsExpanded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="nodifyvm:NodeViewModel">

                      <Border Margin="0,3"
                              Padding="12,9"
                              CornerRadius="7"
                              Background="{DynamicResource SurfaceBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"
                              BoxShadow="0 4 10 0 #080F172A"
                              PointerPressed="OnNodePressed"
                              PointerMoved="OnNodeDrag"
                              PointerExited="OnNodeExited">

                        <Grid ColumnDefinitions="Auto,*">

                          <Border Grid.Column="0"
                                  Width="9"
                                  Height="9"
                                  CornerRadius="5"
                                  Background="{DynamicResource PrimaryBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0" />

                          <TextBlock Grid.Column="1"
                                     Text="{Binding Title}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Center" />

                        </Grid>
                      </Border>

                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>

            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </Grid>
  </Border>
</UserControl>
