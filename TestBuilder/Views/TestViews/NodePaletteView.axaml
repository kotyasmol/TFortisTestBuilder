<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             xmlns:nodifyvm="using:TestBuilder.ViewModels.NodifyVM"
             x:Class="TestBuilder.Views.TestViews.NodePaletteView"
             x:DataType="vm:TestViewModel">

  <Border CornerRadius="0"
          BorderThickness="1,0,0,0"
          BorderBrush="{DynamicResource SidebarBorderBrush}"
          Background="{DynamicResource SidebarDarkBrush}"
          ClipToBounds="True">

    <Grid RowDefinitions="Auto,*">

      <Border Grid.Row="0"
              Background="{DynamicResource SidebarDarkAltBrush}"
              Padding="{StaticResource PanelInset}">

        <StackPanel Spacing="4">
          <TextBlock Text="Добавить ноду"
                     FontSize="{StaticResource FontSection}"
                     FontWeight="Bold"
                     Foreground="{DynamicResource SidebarTextBrush}" />

          <TextBlock Text="Перетащите элемент на граф" TextWrapping="Wrap"
                     FontSize="{StaticResource FontBody}"
                     Foreground="{DynamicResource SidebarTextMutedBrush}" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

        <ItemsControl ItemsSource="{Binding AvailableNodeCategories}"
                      Margin="12,0,12,12">

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NodePaletteCategoryViewModel">

              <StackPanel Margin="0,0,0,12"
                          Spacing="6">

                <Button Command="{Binding ToggleCommand}"
                        Classes="listHeader"
                        Padding="8,10"
                        HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Grid Width="14" Height="14" VerticalAlignment="Center">
  <PathIcon Width="10" Height="10" Data="M2 4 L7 9 12 4 14 6 7 13 0 6 Z" IsVisible="{Binding IsExpanded}" Foreground="{DynamicResource TextSecondaryBrush}" />
  <PathIcon Width="10" Height="10" Data="M4 0 L11 7 4 14 2 12 7 7 2 2 Z" IsVisible="{Binding !IsExpanded}" Foreground="{DynamicResource TextSecondaryBrush}" />
</Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Nodes.Count}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <ItemsControl ItemsSource="{Binding Nodes}"
                              IsVisible="{Binding IsExpanded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="nodifyvm:NodeViewModel">

                      <Border Classes="nodeEntry" Margin="0,1"
                              Padding="12,10"
                              CornerRadius="{StaticResource UiCornerRadius}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="0"
                              PointerPressed="OnNodePressed"
                              PointerMoved="OnNodeDrag"
                              PointerExited="OnNodeExited"
                              ToolTip.ShowDelay="400" ToolTip.Placement="Left">
                        <ToolTip.Tip>
                          <StackPanel MaxWidth="300" Spacing="6">
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HelpSummary}" TextWrapping="Wrap" />
                          </StackPanel>
                        </ToolTip.Tip>

                        <Grid ColumnDefinitions="Auto,*">

                          <PathIcon Width="12" Height="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Data="M1 1 H3 V3 H1 Z M7 1 H9 V3 H7 Z M1 6 H3 V8 H1 Z M7 6 H9 V8 H7 Z M1 11 H3 V13 H1 Z M7 11 H9 V13 H7 Z" />

                          <TextBlock Grid.Column="1"
                                     Text="{Binding DisplayTitle}"
                                     FontSize="{StaticResource FontBody}"
                                     FontWeight="Normal"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Center" />

                        </Grid>
                      </Border>

                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>

            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </Grid>
  </Border>
</UserControl>
