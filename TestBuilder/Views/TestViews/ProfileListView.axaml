<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             xmlns:converters="using:TestBuilder.Converters"
             x:Class="TestBuilder.Views.TestViews.ProfileListView"
             x:DataType="vm:TestViewModel">

  <UserControl.Resources>
    <converters:CollectionEmptyConverter x:Key="CollectionEmptyConverter" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*">

    <Grid Grid.Row="0"
          ColumnDefinitions="*,Auto,Auto"
          Margin="0,0,0,8">
      <StackPanel Grid.Column="0">
        <TextBlock Text="Профили тестирования"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding StatusMessage}"
                   FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}"
                   IsVisible="False" />
      </StackPanel>
      <Button Grid.Column="1"
              Command="{Binding NewProfileCommand}"
              ToolTip.Tip="Создать новый пустой профиль"
              Width="32"
              Height="32"
              Padding="4"
              Classes="ghost"
              VerticalAlignment="Center"
              CornerRadius="7"
              Margin="0,0,4,0">
        <PathIcon Width="16"
                  Height="16"
                  Data="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z"
                  Foreground="{DynamicResource TextSecondaryBrush}" />
      </Button>
      <Button Grid.Column="2"
              Command="{Binding ImportProfilesCommand}"
              ToolTip.Tip="Импортировать профили с компьютера"
              Width="32"
              Height="32"
              Padding="4"
              Classes="ghost"
              VerticalAlignment="Center"
              CornerRadius="7">
        <PathIcon Width="16"
                  Height="16"
                  Data="M12 3v10m0 0l-4-4m4 4l4-4 M5 19h14v2H5z"
                  Foreground="{DynamicResource TextSecondaryBrush}" />
      </Button>
    </Grid>

    <TextBox Grid.Row="1"
             Text="{Binding ProfileSearch}"
             Watermark="Поиск по названию..."
             Margin="0,0,0,10" />

    <Border Grid.Row="2"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            CornerRadius="8"
            Background="{DynamicResource SurfaceBrush}"
            ClipToBounds="True">
      <Grid>
        <ListBox x:Name="ProfileListBox"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile}"
                 Background="Transparent"
                 SelectionChanged="OnProfileSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}"
                         TextWrapping="Wrap"
                         FontSize="13"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    IsHitTestVisible="False"
                    IsVisible="{Binding Profiles.Count, Converter={StaticResource CollectionEmptyConverter}}">
          <Border Width="32"
                  Height="26"
                  CornerRadius="5"
                  BorderBrush="{DynamicResource TextMutedBrush}"
                  BorderThickness="1"
                  Opacity="0.65">
            <PathIcon Width="18"
                      Height="18"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M4 6h6l2 2h8v10H4z M6 10v6h12v-6z"
                      Foreground="{DynamicResource TextMutedBrush}" />
          </Border>
          <TextBlock Text="Нет профилей"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Создайте профиль&#x0a;тестирования"
                     FontSize="12"
                     LineHeight="18"
                     TextAlignment="Center"
                     Foreground="{DynamicResource TextMutedBrush}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</UserControl>
