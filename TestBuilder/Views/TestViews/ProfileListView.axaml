<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             x:Class="TestBuilder.Views.TestViews.ProfileListView"
             x:DataType="vm:TestViewModel">

  <Grid RowDefinitions="Auto,Auto,*">

    <Grid Grid.Row="0"
          ColumnDefinitions="*,Auto"
          Margin="0,0,0,8">
      <StackPanel Grid.Column="0">
        <TextBlock Text="Профили тестирования"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding StatusMessage}"
                   FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}"
                   IsVisible="False" />
      </StackPanel>
      <Button Grid.Column="1"
              Command="{Binding ImportProfilesCommand}"
              ToolTip.Tip="Импортировать профили с компьютера"
              Width="28"
              Height="28"
              Padding="4"
              Background="Transparent"
              VerticalAlignment="Center">
        <PathIcon Width="16"
                  Height="16"
                  Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z"
                  Foreground="{DynamicResource TextPrimaryBrush}" />
      </Button>
    </Grid>

    <TextBox Grid.Row="1"
             Text="{Binding ProfileSearch}"
             Watermark="Поиск по названию..."
             Margin="0,0,0,10" />

    <Border Grid.Row="2"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            CornerRadius="12"
            Background="{DynamicResource SurfaceAltBrush}"
            ClipToBounds="True">
      <ListBox x:Name="ProfileListBox"
               ItemsSource="{Binding Profiles}"
               SelectedItem="{Binding SelectedProfile}"
               Background="Transparent"
               SelectionChanged="OnProfileSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

  </Grid>
</UserControl>
