<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             xmlns:services="using:TestBuilder.Services"
             xmlns:converters="using:TestBuilder.Converters"
             x:Class="TestBuilder.Views.TestViews.ProfileListView"
             x:DataType="vm:TestViewModel">

  <UserControl.Resources>
    <converters:CollectionEmptyConverter x:Key="CollectionEmptyConverter" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
    <TextBlock Text="Профили тестов" Classes="sectionTitle" Margin="0,0,0,12" Foreground="{DynamicResource PrimaryTextBrush}" />
    <ComboBox Grid.Row="1" ItemsSource="{Binding ProductFilters}" SelectedItem="{Binding ProductFilter}" IsEnabled="{Binding CanChooseProfile}" HorizontalAlignment="Stretch" Margin="0,0,0,8" AutomationProperties.Name="Вид изделия" />
    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,0,0,12">
      <Button Classes="sidebarAction" HorizontalAlignment="Stretch" Content="Новый" Command="{Binding NewProfileCommand}" Margin="0,0,8,0" ToolTip.Tip="Создать пустой профиль" />
      <Button Classes="sidebarAction" Grid.Column="1" HorizontalAlignment="Stretch" Content="Импорт" Command="{Binding ImportProfilesCommand}" ToolTip.Tip="Импортировать JSON-профиль" />
    </Grid>
    <TextBox Grid.Row="3" Text="{Binding ProfileSearch}" Watermark="Поиск профиля" Margin="0,0,0,12" />
    <TextBlock Grid.Row="4" Text="{Binding CatalogStatus}" IsVisible="{Binding HasCatalogStatus}" Classes="hint" Margin="0,0,0,8" />
    <Border Grid.Row="5"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            CornerRadius="8"
            Background="{DynamicResource SurfaceBrush}"
            ClipToBounds="True">
      <Grid>
        <ScrollViewer x:Name="ProfileListBox" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding EngineerProfileGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EngineerProfileGroup">
                <StackPanel Margin="0,4,0,8">
                  <Button Classes="listHeader" Command="{Binding ToggleExpandedCommand}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Grid Width="14" Height="14" VerticalAlignment="Center">
  <PathIcon Width="10" Height="10" Data="M2 4 L7 9 12 4 14 6 7 13 0 6 Z" IsVisible="{Binding IsExpanded}" Foreground="{DynamicResource TextSecondaryBrush}" />
  <PathIcon Width="10" Height="10" Data="M4 0 L11 7 4 14 2 12 7 7 2 2 Z" IsVisible="{Binding !IsExpanded}" Foreground="{DynamicResource TextSecondaryBrush}" />
</Grid>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="8,0" />
                      <TextBlock Grid.Column="2" Text="{Binding Profiles.Count}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <ListBox ItemContainerTheme="{StaticResource ProfileItemTheme}" IsVisible="{Binding IsExpanded}" ItemsSource="{Binding Profiles}" SelectionChanged="OnGroupSelectionChanged"
                           Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="services:GraphProfile">
                        <StackPanel Spacing="5" ToolTip.Tip="{Binding FilePath}">
                          <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontSize="{StaticResource FontBody}" />
                          <TextBlock Text="{Binding UpdatedAtText}" IsVisible="{Binding HasUpdatedAt}"
                                     HorizontalAlignment="Right" FontSize="11"
                                     Foreground="{DynamicResource TextMutedBrush}" ToolTip.Tip="{Binding UpdatedAtTooltip}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    IsHitTestVisible="False"
                    IsVisible="{Binding Profiles.Count, Converter={StaticResource CollectionEmptyConverter}}">
          <Border Width="32"
                  Height="26"
                  CornerRadius="5"
                  BorderBrush="{DynamicResource TextMutedBrush}"
                  BorderThickness="1"
                  Opacity="0.65">
            <PathIcon Width="18"
                      Height="18"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M4 6h6l2 2h8v10H4z M6 10v6h12v-6z"
                      Foreground="{DynamicResource TextMutedBrush}" />
          </Border>
          <TextBlock Text="Нет профилей"
                     FontSize="{StaticResource FontBody}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Создайте профиль&#x0a;тестирования"
                     FontSize="{StaticResource FontCaption}"
                     LineHeight="18"
                     TextAlignment="Center"
                     Foreground="{DynamicResource TextMutedBrush}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</UserControl>
