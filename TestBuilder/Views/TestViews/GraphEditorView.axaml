<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             xmlns:nodify="using:Nodify"
             xmlns:nodifyvm="using:TestBuilder.ViewModels.NodifyVM"
             xmlns:stepvm="using:TestBuilder.ViewModels.StepVM"
             xmlns:views="using:TestBuilder.Views"
             xmlns:testviews="using:TestBuilder.Views.TestViews"
             x:Name="Root"
             x:Class="TestBuilder.Views.TestViews.GraphEditorView"
             x:DataType="vm:TestViewModel">

  <UserControl.Resources>

    <DataTemplate x:Key="NodeHeaderHelpTemplate"
                  x:DataType="nodifyvm:NodeViewModel">
      <DockPanel LastChildFill="True"
                 MinWidth="0">
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="5"
                    VerticalAlignment="Top">
          <Border Width="14"
                  Height="14"
                  CornerRadius="7"
                  Background="{Binding NodeColorBrush}"
                  VerticalAlignment="Center" />
          <ComboBox Width="112"
                    ItemsSource="{Binding NodeColors}"
                    SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                    FontSize="11"
                    VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="nodifyvm:NodeColorOption">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Border Width="12"
                          Height="12"
                          CornerRadius="6"
                          Background="{Binding Brush}"
                          VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <Border DockPanel.Dock="Right"
                Classes="nodeHelpTrigger"
                Width="22"
                Height="22"
                Margin="8,0,0,0"
                CornerRadius="11"
                BorderThickness="1"
                IsVisible="{Binding HasHelpText}"
                PointerPressed="OnNodeHelpPointerPressed"
                VerticalAlignment="Top">
          <PathIcon Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Data="M11 10h2v7h-2z M11 7h2v2h-2z M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M12 4a8 8 0 1 1 0 16 8 8 0 0 1 0-16z" />
        </Border>
        <TextBlock Text="{Binding Title}"
                   MaxWidth="320"
                   TextWrapping="Wrap"
                   LineHeight="17"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="ModbusWriteHeaderTemplate"
                  x:DataType="stepvm:ModbusWriteNodeViewModel">
      <DockPanel LastChildFill="True"
                 MinWidth="0">
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
          <Border Classes="nodeHelpTrigger"
                  Width="20"
                  Height="20"
                  CornerRadius="10"
                  BorderThickness="1"
                  IsVisible="{Binding HasHelpText}"
                  PointerPressed="OnNodeHelpPointerPressed"
                  VerticalAlignment="Center">
            <PathIcon Width="14"
                      Height="14"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource TextSecondaryBrush}"
                      Data="M11 10h2v7h-2z M11 7h2v2h-2z M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M12 4a8 8 0 1 1 0 16 8 8 0 0 1 0-16z" />
          </Border>
          <Button x:Name="ColorPickerTrigger"
                  Classes="nodeColorTrigger"
                  Background="{Binding NodeColorBrush}"
                  ToolTip.Tip="Изменить цвет ноды">
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <Border Padding="8"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <UniformGrid Columns="4">
                    <Button Classes="nodeColorChoice" Background="#3B82F6" ToolTip.Tip="Синий" Command="{Binding SelectColorCommand}" CommandParameter="blue" />
                    <Button Classes="nodeColorChoice" Background="#14B8A6" ToolTip.Tip="Бирюзовый" Command="{Binding SelectColorCommand}" CommandParameter="turquoise" />
                    <Button Classes="nodeColorChoice" Background="#22C55E" ToolTip.Tip="Зелёный" Command="{Binding SelectColorCommand}" CommandParameter="green" />
                    <Button Classes="nodeColorChoice" Background="#EAB308" ToolTip.Tip="Жёлтый" Command="{Binding SelectColorCommand}" CommandParameter="yellow" />
                    <Button Classes="nodeColorChoice" Background="#F97316" ToolTip.Tip="Оранжевый" Command="{Binding SelectColorCommand}" CommandParameter="orange" />
                    <Button Classes="nodeColorChoice" Background="#EF4444" ToolTip.Tip="Красный" Command="{Binding SelectColorCommand}" CommandParameter="red" />
                    <Button Classes="nodeColorChoice" Background="#A855F7" ToolTip.Tip="Фиолетовый" Command="{Binding SelectColorCommand}" CommandParameter="purple" />
                  </UniformGrid>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <TextBlock Text="{Binding Title}"
                   MaxWidth="320"
                   TextWrapping="Wrap"
                   LineHeight="17"
                   FontWeight="SemiBold"
                   Foreground="{Binding NodeHeaderTextBrush}"
                   VerticalAlignment="Center" />
      </DockPanel>
    </DataTemplate>

  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.nodeHelpTrigger">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.nodeHelpTrigger:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style Selector="Button.nodeColorTrigger">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="MaxWidth" Value="20" />
      <Setter Property="MaxHeight" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="#F8FAFC" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.nodeColorTrigger:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="Button.nodeColorChoice">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Border.nodeHelpClose">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.nodeHelpClose:pointerover">
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0"
            Padding="12,10"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*">

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
          <Button Command="{Binding GoBackGraphCommand}"
                  IsEnabled="{Binding CanGoBackGraph}"
                  Classes="ghost"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="14"
                        Height="14"
                        Data="M11 5l-7 7 7 7v-5h9v-4h-9z"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="Назад"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Button>

          <Button Command="{Binding RunGraphCommand}"
                  Classes="primary"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="13"
                        Height="13"
                        Data="M8 5v14l11-7z"
                        Foreground="{DynamicResource OnPrimaryBrush}" />
              <TextBlock Text="Запустить граф"
                         Foreground="{DynamicResource OnPrimaryBrush}"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Button>

          <Button Command="{Binding PauseTestCommand}"
                  IsVisible="{Binding IsTestRunning}"
                  IsEnabled="{Binding !IsTestPaused}"
                  Classes="ghost"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="13"
                        Height="13"
                        Data="M6 4h4v16H6z M14 4h4v16h-4z"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="Пауза"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Button>

          <Button Command="{Binding ResumeTestCommand}"
                  IsVisible="{Binding IsTestPaused}"
                  Classes="primary"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="13"
                        Height="13"
                        Data="M8 5v14l11-7z"
                        Foreground="{DynamicResource OnPrimaryBrush}" />
              <TextBlock Text="Продолжить"
                         Foreground="{DynamicResource OnPrimaryBrush}"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Button>

          <Button Command="{Binding StopTestCommand}"
                  IsVisible="{Binding IsTestRunning}"
                  Classes="ghost"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="12"
                        Height="12"
                        Data="M6 6h12v12H6z"
                        Foreground="#DC2626" />
              <TextBlock Text="Остановить"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding UndoCommand}"
                  IsEnabled="{Binding CanUndo}"
                  Classes="ghost icon"
                  ToolTip.Tip="Отменить (Ctrl+Z)"
                  Width="38"
                  Height="36">
            <Path Fill="{DynamicResource TextPrimaryBrush}"
                     Data="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2v1z M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466z"
                     Width="14" Height="14"
                     Stretch="Fill" />
          </Button>
          <Button Command="{Binding RedoCommand}"
                  IsEnabled="{Binding CanRedo}"
                  Classes="ghost icon"
                  ToolTip.Tip="Повторить (Ctrl+Y)"
                  Width="38"
                  Height="36">
            <Path Fill="{DynamicResource TextPrimaryBrush}"
                     Data="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"
                     Width="14" Height="14"
                     Stretch="Fill" />
          </Button>

          <Button Command="{Binding NewProfileCommand}"
                  Classes="ghost"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="14"
                        Height="14"
                        Data="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="Новый"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Button>

          <Button Command="{Binding ClearGraphCommand}"
                  Classes="ghost"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="14"
                        Height="14"
                        Data="M7 4V2h10v2h5v2H2V4h5z M5 8h14l-1 14H6z"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="Очистить"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Button>

          <Button Command="{Binding SaveGraphCommand}"
                  Classes="ghost"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="14"
                        Height="14"
                        Data="M5 3h12l2 2v16H5z M7 5v6h10V6.5L15.5 5z M8 15h8v4H8z"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="Сохранить"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>



        <TextBlock Grid.Column="1"
                   Text="{Binding CurrentGraphPath}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="13" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <nodify:NodifyEditor x:Name="Editor"
                           ItemsSource="{Binding Nodes}"
                           Connections="{Binding Connections}"
                           PendingConnection="{Binding PendingConnection}"
                           DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                           SelectedItems="{Binding SelectedNodes}"
                           Background="{DynamicResource EditorBackgroundBrush}"
                           GridCellSize="16"
                           DragDrop.AllowDrop="True">

        <nodify:NodifyEditor.ItemContainerTheme>
          <ControlTheme TargetType="nodify:ItemContainer"
                        BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
            <Setter Property="Location"
                    Value="{Binding Location}"
                    x:DataType="nodifyvm:NodeViewModel" />
            <Setter Property="BorderBrush"
                    Value="{Binding ExecutionBorderBrush}"
                    x:DataType="nodifyvm:NodeViewModel" />
            <Setter Property="BorderThickness"
                    Value="{Binding ExecutionBorderThickness}"
                    x:DataType="nodifyvm:NodeViewModel" />
          </ControlTheme>
        </nodify:NodifyEditor.ItemContainerTheme>

        <nodify:NodifyEditor.ItemTemplate>
          <views:NodeTemplateSelector>

            <views:NodeTemplateSelector.DefaultTemplate>
              <DataTemplate x:DataType="nodifyvm:NodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="LabelNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.DefaultTemplate>

            <views:NodeTemplateSelector.ModbusWriteTemplate>
              <DataTemplate x:DataType="stepvm:ModbusWriteNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource ModbusWriteHeaderTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="ModbusNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}"
                             HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="230">
                    <Grid ColumnDefinitions="76,*,Auto">
                      <TextBlock Grid.Column="0" Text="Slave ID:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <ComboBox Grid.Column="1"
                                IsVisible="{Binding IsConnected}"
                                ItemsSource="{Binding AvailableSlaves}"
                                SelectedItem="{Binding SelectedSlave}"
                                FontSize="12"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="1"
                               IsVisible="{Binding !IsConnected}"
                               Text="{Binding SlaveIdText}"
                               FontSize="12" />
                      <StackPanel Grid.Column="2"
                                  Orientation="Horizontal"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Center">
                        <TextBlock Text="ID "
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SlaveId}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                      </StackPanel>
                    </Grid>

                    <CheckBox Content="Slave из цикла"
                              IsChecked="{Binding UseCurrentSlaveId}"
                              FontSize="12" />

                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Адрес:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <ComboBox Grid.Column="1"
                                IsVisible="{Binding ShowRegisterSelector}"
                                ItemsSource="{Binding AvailableRegisters}"
                                SelectedItem="{Binding SelectedRegister}"
                                FontSize="12"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="1"
                               IsVisible="{Binding ShowAddressTextBox}"
                               Text="{Binding AddressText}"
                               FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Значение:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding ValueText}" FontSize="12" />
                    </Grid>

                    <TextBlock Text="{Binding IntegerInputError}"
                               IsVisible="{Binding HasIntegerInputError}"
                               FontSize="11"
                               Foreground="#DC2626"
                               TextWrapping="Wrap" />

                    <CheckBox Content="Проверка"
                              IsChecked="{Binding VerifyWrite}"
                              FontSize="12" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.ModbusWriteTemplate>

            <views:NodeTemplateSelector.SelfTestCheckTemplate>
              <DataTemplate x:DataType="stepvm:SelfTestCheckNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="HttpNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="320">
                    <Grid ColumnDefinitions="88,*">
                      <TextBlock Grid.Column="0" Text="URL:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Url}"
                               FontSize="12"
                               Watermark="http://192.168.0.1/cgi-bin/luci/admin/statistics/deviceinfo?..." />
                    </Grid>

                    <Grid ColumnDefinitions="88,*">
                      <TextBlock Grid.Column="0" Text="Timeout:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="88,*">
                      <TextBlock Grid.Column="0" Text="Poll ms:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding PollIntervalMs}" FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="88,*">
                      <TextBlock Grid.Column="0" Text="Prefix:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding OutputPrefix}" FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="88,*">
                      <TextBlock Grid.Column="0" Text="Min/Max:" VerticalAlignment="Top" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding ValidationRules}"
                               FontSize="12"
                               TextWrapping="NoWrap"
                               AcceptsReturn="True"
                               Height="118" />
                    </Grid>

                    <CheckBox Content="Критическая ошибка при провале"
                              IsChecked="{Binding FailOnError}"
                              FontSize="12" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.SelfTestCheckTemplate>
            <views:NodeTemplateSelector.GetSerialNumberTemplate>
              <DataTemplate x:DataType="stepvm:GetSerialNumberFromServerNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="HttpNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="340">
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Server:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding ServerBaseUrl}"
                               FontSize="12"
                               Watermark="пусто = Server base URL из Настроек" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Device:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding DeviceType}"
                               FontSize="12"
                               Watermark="PSW+UPS-Box 8x2Pro" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="CPU var:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding CpuIdVariableName}"
                               FontSize="12"
                               Watermark="Dut.cpu_id" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Output:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding OutputVariableName}"
                               FontSize="12"
                               Watermark="SerialNumber" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Timeout:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*,8,*">
                      <TextBlock Grid.Column="0" Text="Retry:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding RetryCount}" FontSize="12" />
                      <TextBox Grid.Column="3" Text="{Binding RetryDelayMs}" FontSize="12" Watermark="delay ms" />
                    </Grid>

                    <CheckBox Content="Критическая ошибка при провале"
                              IsChecked="{Binding FailOnError}"
                              FontSize="12" />
                  </StackPanel>
                </nodify:Node>
