                      <TextBlock Grid.Column="0" Text="Slave ID:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <ComboBox Grid.Column="1" IsVisible="{Binding IsConnected}" ItemsSource="{Binding AvailableSlaves}" SelectedItem="{Binding SelectedSlave}" FontSize="12" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="1" IsVisible="{Binding !IsConnected}" Text="{Binding SlaveId}" FontSize="12" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ID " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SlaveId}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                      </StackPanel>
                    </Grid>
                    <CheckBox Content="Slave из цикла" IsChecked="{Binding UseCurrentSlaveId}" FontSize="12" />
                    <CheckBox Content="Live Modbus read" IsChecked="{Binding LiveRead}" FontSize="12" />
                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Адрес:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <ComboBox Grid.Column="1" IsVisible="{Binding ShowRegisterSelector}" ItemsSource="{Binding AvailableRegisters}" SelectedItem="{Binding SelectedRegister}" FontSize="12" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="1" IsVisible="{Binding ShowAddressTextBox}" Text="{Binding Address}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Минимум:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Min}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Максимум:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Max}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Кол-во замеров:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding SampleCount}" FontSize="12" />
                    </Grid>
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.PollRegisterTemplate>

            <views:NodeTemplateSelector.ClearArpCacheTemplate>
              <DataTemplate x:DataType="stepvm:ClearArpCacheNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="OperatorNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
