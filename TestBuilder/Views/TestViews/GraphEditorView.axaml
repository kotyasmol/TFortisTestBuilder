                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Repeats:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding RepeatCount}" FontSize="12" />
