                    <CheckBox Content="Run arpd.bat" IsChecked="{Binding RunArpdBat}" FontSize="12" />
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Bat path:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding ArpdBatPath}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Command:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Command}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Arguments:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Arguments}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Timeout ms:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="12" />
                    </Grid>
                    <CheckBox Content="Fail on error" IsChecked="{Binding FailOnError}" FontSize="12" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
