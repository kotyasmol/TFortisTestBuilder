            <views:NodeTemplateSelector.LabelTemplate>
              <DataTemplate x:DataType="stepvm:LabelNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="LabelNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <Grid Margin="10,6,10,10"
                        Width="{Binding LabelWidth}"
                        Height="{Binding LabelHeight}"
                        MinWidth="190"
                        MinHeight="88">
                    <TextBox Text="{Binding Text}"
                             FontSize="14"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch"
                             Padding="6,4,18,18" />
                    <Border Width="16"
                            Height="16"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#00000000"
                            PointerPressed="OnLabelResizePointerPressed"
                            PointerMoved="OnLabelResizePointerMoved"
                            PointerReleased="OnLabelResizePointerReleased">
                      <Border Width="8"
                              Height="8"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              BorderBrush="{DynamicResource TextSecondaryBrush}"
                              BorderThickness="0,0,2,2" />
                    </Border>
                  </Grid>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.LabelTemplate>

            <views:NodeTemplateSelector.SubtestTemplate>
              <DataTemplate x:DataType="stepvm:SubtestNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="SubtestNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="240">
                    <Grid ColumnDefinitions="78,*">
                      <TextBlock Grid.Column="0" Text="Название:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Name}" FontSize="12" />
                    </Grid>

                    <TextBox Text="{Binding Description}"
                             FontSize="12"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Height="48"
                             Watermark="Описание" />

                    <Grid ColumnDefinitions="*,*">
                      <CheckBox Grid.Column="0" Content="Включен" IsChecked="{Binding IsEnabled}" FontSize="12" />
                      <CheckBox Grid.Column="1" Content="Стоп" IsChecked="{Binding StopOnError}" FontSize="12" Margin="8,0,0,0" />
                    </Grid>

                    <CheckBox Content="Cleanup on failure/stop"
                              IsChecked="{Binding RunOnFailure}"
                              FontSize="12" />

                    <TextBlock Text="{Binding StepCount, StringFormat='Шагов: {0}'}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ProgressText, StringFormat='Сейчас: {0}'}"
                               IsVisible="{Binding HasProgress}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource NodeWaitBrush}" />

                    <Button Content="Открыть"
                            x:CompileBindings="False"
                            Command="{Binding DataContext.OpenCompositeNodeBodyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Classes="ghost"
                            FontSize="12" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.SubtestTemplate>
            <views:NodeTemplateSelector.ForEachSlaveTemplate>
