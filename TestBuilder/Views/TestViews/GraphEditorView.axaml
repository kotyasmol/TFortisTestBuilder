            <views:NodeTemplateSelector.CheckVariableEqualityTemplate>
              <DataTemplate x:DataType="stepvm:CheckVariableEqualityNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="EqualityNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="300">
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Variable:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding VariableName}" FontSize="12" Watermark="Dut.init_ok" />
                    </Grid>
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Expected:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding ExpectedValue}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Type:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding ComparisonType}" FontSize="12" Watermark="Number" />
                    </Grid>
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Fail:" VerticalAlignment="Top" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding FailMessage}" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" Height="52" />
                    </Grid>
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.CheckVariableEqualityTemplate>

            <views:NodeTemplateSelector.CheckVariableRangeTemplate>
