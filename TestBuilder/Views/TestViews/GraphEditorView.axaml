<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             xmlns:nodify="using:Nodify"
             xmlns:nodifyvm="using:TestBuilder.ViewModels.NodifyVM"
             xmlns:stepvm="using:TestBuilder.ViewModels.StepVM"
             xmlns:views="using:TestBuilder.Views"
             xmlns:testviews="using:TestBuilder.Views.TestViews"
             x:Class="TestBuilder.Views.TestViews.GraphEditorView"
             x:DataType="vm:TestViewModel">

  <UserControl.Resources>

    <GeometryDrawing x:Key="SmallGridGeometry"
                     Geometry="M0,0 L0,1 0.025,1 0.025,0.025 1,0.025 1,0 Z"
                     Brush="{DynamicResource GridLineBrush}" />

    <DrawingBrush x:Key="SmallGridBrush"
                  TileMode="Tile"
                  DestinationRect="0 0 16 16"
                  TransformOrigin="0,0"
                  Transform="{Binding DpiScaledViewportTransform, ElementName=Editor}"
                  Drawing="{StaticResource SmallGridGeometry}" />

  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0"
            Padding="12,10"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*">

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
          <Button Command="{Binding GoBackGraphCommand}"
                  IsEnabled="{Binding CanGoBackGraph}"
                  Classes="ghost"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="14"
                        Height="14"
                        Data="M11 5l-7 7 7 7v-5h9v-4h-9z"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="Назад"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Button>

          <Button Command="{Binding RunGraphCommand}"
                  Classes="primary"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="13"
                        Height="13"
                        Data="M8 5v14l11-7z"
                        Foreground="{DynamicResource OnPrimaryBrush}" />
              <TextBlock Text="Запустить граф"
                         Foreground="{DynamicResource OnPrimaryBrush}"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Button>

          <Button Command="{Binding PauseTestCommand}"
                  IsVisible="{Binding IsTestRunning}"
                  IsEnabled="{Binding !IsTestPaused}"
                  Classes="ghost"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="13"
                        Height="13"
                        Data="M6 4h4v16H6z M14 4h4v16h-4z"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="Пауза"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Button>

          <Button Command="{Binding ResumeTestCommand}"
                  IsVisible="{Binding IsTestPaused}"
                  Classes="primary"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="13"
                        Height="13"
                        Data="M8 5v14l11-7z"
                        Foreground="{DynamicResource OnPrimaryBrush}" />
              <TextBlock Text="Продолжить"
                         Foreground="{DynamicResource OnPrimaryBrush}"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Button>

          <Button Command="{Binding StopTestCommand}"
                  IsVisible="{Binding IsTestRunning}"
                  Classes="ghost"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="12"
                        Height="12"
                        Data="M6 6h12v12H6z"
                        Foreground="#DC2626" />
              <TextBlock Text="Остановить"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding UndoCommand}"
                  IsEnabled="{Binding CanUndo}"
                  Classes="ghost icon"
                  ToolTip.Tip="Отменить (Ctrl+Z)"
                  Width="38"
                  Height="36">
            <Path Fill="{DynamicResource TextPrimaryBrush}"
                     Data="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2v1z M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466z"
                     Width="14" Height="14"
                     Stretch="Fill" />
          </Button>
          <Button Command="{Binding RedoCommand}"
                  IsEnabled="{Binding CanRedo}"
                  Classes="ghost icon"
                  ToolTip.Tip="Повторить (Ctrl+Y)"
                  Width="38"
                  Height="36">
            <Path Fill="{DynamicResource TextPrimaryBrush}"
                     Data="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"
                     Width="14" Height="14"
                     Stretch="Fill" />
          </Button>

          <Button Command="{Binding ClearGraphCommand}"
                  Classes="ghost"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="14"
                        Height="14"
                        Data="M7 4V2h10v2h5v2H2V4h5z M5 8h14l-1 14H6z"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="Очистить"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Button>

          <Button Command="{Binding SaveGraphCommand}"
                  Classes="ghost"
                  Height="36">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <PathIcon Width="14"
                        Height="14"
                        Data="M5 3h12l2 2v16H5z M7 5v6h10V6.5L15.5 5z M8 15h8v4H8z"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="Сохранить"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>



        <TextBlock Grid.Column="1"
                   Text="{Binding CurrentGraphPath}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="13" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <nodify:NodifyEditor x:Name="Editor"
                           ItemsSource="{Binding Nodes}"
                           Connections="{Binding Connections}"
                           PendingConnection="{Binding PendingConnection}"
                           DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                           SelectedItems="{Binding SelectedNodes}"
                           Background="{StaticResource SmallGridBrush}"
                           GridCellSize="16"
                           DragDrop.AllowDrop="True">

        <nodify:NodifyEditor.ItemContainerTheme>
          <ControlTheme TargetType="nodify:ItemContainer"
                        BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
            <Setter Property="Location"
                    Value="{Binding Location}"
                    x:DataType="nodifyvm:NodeViewModel" />
            <Setter Property="BorderBrush"
                    Value="{Binding ExecutionBorderBrush}"
                    x:DataType="nodifyvm:NodeViewModel" />
            <Setter Property="BorderThickness"
                    Value="{Binding ExecutionBorderThickness}"
                    x:DataType="nodifyvm:NodeViewModel" />
          </ControlTheme>
        </nodify:NodifyEditor.ItemContainerTheme>

        <nodify:NodifyEditor.ItemTemplate>
          <views:NodeTemplateSelector>

            <views:NodeTemplateSelector.DefaultTemplate>
              <DataTemplate x:DataType="nodifyvm:NodeViewModel">
                <nodify:Node Header="{Binding Title}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="LabelNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource NodeStartBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.DefaultTemplate>

            <views:NodeTemplateSelector.ModbusWriteTemplate>
              <DataTemplate x:DataType="stepvm:ModbusWriteNodeViewModel">
                <nodify:Node Header="{Binding Title}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="ModbusNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource NodeModbusBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="230">
                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Slave ID:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <ComboBox Grid.Column="1"
                                IsVisible="{Binding IsConnected}"
                                ItemsSource="{Binding AvailableSlaves}"
                                SelectedItem="{Binding SelectedSlave}"
                                FontSize="12"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="1"
                               IsVisible="{Binding !IsConnected}"
                               Text="{Binding SlaveIdText}"
                               FontSize="12" />
                    </Grid>

                    <CheckBox Content="Slave из цикла"
                              IsChecked="{Binding UseCurrentSlaveId}"
                              FontSize="12" />

                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Адрес:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <ComboBox Grid.Column="1"
                                IsVisible="{Binding ShowRegisterSelector}"
                                ItemsSource="{Binding AvailableRegisters}"
                                SelectedItem="{Binding SelectedRegister}"
                                FontSize="12"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="1"
                               IsVisible="{Binding ShowAddressTextBox}"
                               Text="{Binding AddressText}"
                               FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Значение:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding ValueText}" FontSize="12" />
                    </Grid>

                    <TextBlock Text="{Binding IntegerInputError}"
                               IsVisible="{Binding HasIntegerInputError}"
                               FontSize="11"
                               Foreground="#DC2626"
                               TextWrapping="Wrap" />

                    <CheckBox Content="Проверка"
                              IsChecked="{Binding VerifyWrite}"
                              FontSize="12" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.ModbusWriteTemplate>

            <views:NodeTemplateSelector.SelfTestCheckTemplate>
              <DataTemplate x:DataType="stepvm:SelfTestCheckNodeViewModel">
                <nodify:Node Header="{Binding Title}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="HttpNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource NodeHttpBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="320">
                    <Grid ColumnDefinitions="88,*">
                      <TextBlock Grid.Column="0" Text="URL:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Url}"
                               FontSize="12"
                               Watermark="http://192.168.0.1/cgi-bin/luci/admin/statistics/deviceinfo?..." />
                    </Grid>

                    <Grid ColumnDefinitions="88,*">
                      <TextBlock Grid.Column="0" Text="Timeout:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="88,*">
                      <TextBlock Grid.Column="0" Text="Prefix:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding OutputPrefix}" FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="88,*">
                      <TextBlock Grid.Column="0" Text="Min/Max:" VerticalAlignment="Top" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding ValidationRules}"
                               FontSize="12"
                               TextWrapping="NoWrap"
                               AcceptsReturn="True"
                               Height="118" />
                    </Grid>

                    <CheckBox Content="Критическая ошибка при провале"
                              IsChecked="{Binding FailOnError}"
                              FontSize="12" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.SelfTestCheckTemplate>
            <views:NodeTemplateSelector.GetSerialNumberTemplate>
              <DataTemplate x:DataType="stepvm:GetSerialNumberFromServerNodeViewModel">
                <nodify:Node Header="{Binding Title}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="HttpNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource NodeHttpBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="340">
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Server:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding ServerBaseUrl}"
                               FontSize="12"
                               Watermark="192.168.0.10 или http://server" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Device:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding DeviceType}"
                               FontSize="12"
                               Watermark="PSW+UPS-Box 8x2Pro" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="CPU var:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding CpuIdVariableName}"
                               FontSize="12"
                               Watermark="Dut.cpu_id" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Output:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding OutputVariableName}"
                               FontSize="12"
                               Watermark="SerialNumber" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Timeout:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*,8,*">
                      <TextBlock Grid.Column="0" Text="Retry:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding RetryCount}" FontSize="12" />
                      <TextBox Grid.Column="3" Text="{Binding RetryDelayMs}" FontSize="12" Watermark="delay ms" />
                    </Grid>

                    <CheckBox Content="Критическая ошибка при провале"
                              IsChecked="{Binding FailOnError}"
                              FontSize="12" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.GetSerialNumberTemplate>
            <views:NodeTemplateSelector.CheckVariableEqualityTemplate>
              <DataTemplate x:DataType="stepvm:CheckVariableEqualityNodeViewModel">
                <nodify:Node Header="{Binding Title}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="EqualityNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource NodeEqualityBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="300">
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Variable:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding VariableName}" FontSize="12" Watermark="Dut.init_ok" />
                    </Grid>
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Expected:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding ExpectedValue}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Type:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding ComparisonType}" FontSize="12" Watermark="Number" />
                    </Grid>
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Fail:" VerticalAlignment="Top" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding FailMessage}" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" Height="52" />
                    </Grid>
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.CheckVariableEqualityTemplate>

            <views:NodeTemplateSelector.CheckVariableRangeTemplate>
              <DataTemplate x:DataType="stepvm:CheckVariableRangeNodeViewModel">
                <nodify:Node Header="{Binding Title}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="RangeNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource NodeRangeBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="300">
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Variable:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding VariableName}" FontSize="12" Watermark="Dut.akb_voltage" />
                    </Grid>
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Min:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Min}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Max:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Max}" FontSize="12" />
                    </Grid>
                    <CheckBox Content="Включая границы" IsChecked="{Binding Inclusive}" FontSize="12" />
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Fail:" VerticalAlignment="Top" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding FailMessage}" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" Height="52" />
                    </Grid>
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.CheckVariableRangeTemplate>

            <views:NodeTemplateSelector.CheckRegisterRangeTemplate>
              <DataTemplate x:DataType="stepvm:CheckRegisterRangeNodeViewModel">
                <nodify:Node Header="{Binding Title}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="RangeNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource NodeRangeBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="230">
                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Slave ID:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <ComboBox Grid.Column="1"
                                IsVisible="{Binding IsConnected}"
                                ItemsSource="{Binding AvailableSlaves}"
                                SelectedItem="{Binding SelectedSlave}"
                                FontSize="12"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="1"
                               IsVisible="{Binding !IsConnected}"
                               Text="{Binding SlaveId}"
                               FontSize="12" />
                    </Grid>

                    <CheckBox Content="Slave из цикла"
                              IsChecked="{Binding UseCurrentSlaveId}"
                              FontSize="12" />

                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Адрес:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <ComboBox Grid.Column="1"
                                IsVisible="{Binding ShowRegisterSelector}"
                                ItemsSource="{Binding AvailableRegisters}"
                                SelectedItem="{Binding SelectedRegister}"
                                FontSize="12"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="1"
                               IsVisible="{Binding ShowAddressTextBox}"
                               Text="{Binding Address}"
                               FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Минимум:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Min}" FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Максимум:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Max}" FontSize="12" />
                    </Grid>
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.CheckRegisterRangeTemplate>

            <views:NodeTemplateSelector.DelayTemplate>
              <DataTemplate x:DataType="stepvm:DelayNodeViewModel">
                <nodify:Node Header="{Binding Title}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="DelayNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource NodeDelayBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="190">
                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Мс:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Milliseconds}" FontSize="12" />
                    </Grid>
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.DelayTemplate>

            <views:NodeTemplateSelector.LabelTemplate>
              <DataTemplate x:DataType="stepvm:LabelNodeViewModel">
                <nodify:Node Header="{Binding Title}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="LabelNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource NodeNeutralBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <Grid Margin="10,6,10,10"
                        Width="{Binding LabelWidth}"
                        Height="{Binding LabelHeight}"
                        MinWidth="190"
                        MinHeight="88">
                    <TextBox Text="{Binding Text}"
                             FontSize="14"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch"
                             Padding="6,4,18,18" />
                    <Border Width="16"
                            Height="16"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#00000000"
                            PointerPressed="OnLabelResizePointerPressed"
                            PointerMoved="OnLabelResizePointerMoved"
                            PointerReleased="OnLabelResizePointerReleased">
                      <Border Width="8"
                              Height="8"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              BorderBrush="{DynamicResource TextSecondaryBrush}"
                              BorderThickness="0,0,2,2" />
                    </Border>
                  </Grid>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.LabelTemplate>

            <views:NodeTemplateSelector.SubtestTemplate>
              <DataTemplate x:DataType="stepvm:SubtestNodeViewModel">
                <nodify:Node Header="{Binding Title}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="SubtestNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource NodeWaitBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="240">
                    <Grid ColumnDefinitions="78,*">
                      <TextBlock Grid.Column="0" Text="Название:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Name}" FontSize="12" />
                    </Grid>

                    <TextBox Text="{Binding Description}"
                             FontSize="12"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Height="48"
                             Watermark="Описание" />

                    <Grid ColumnDefinitions="*,*">
                      <CheckBox Grid.Column="0" Content="Включен" IsChecked="{Binding IsEnabled}" FontSize="12" />
                      <CheckBox Grid.Column="1" Content="Стоп" IsChecked="{Binding StopOnError}" FontSize="12" Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="{Binding StepCount, StringFormat='Шагов: {0}'}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ProgressText, StringFormat='Сейчас: {0}'}"
                               IsVisible="{Binding HasProgress}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource NodeWaitBrush}" />

                    <Button Content="Открыть"
                            x:CompileBindings="False"
                            Command="{Binding DataContext.OpenCompositeNodeBodyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Classes="ghost"
                            FontSize="12" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.SubtestTemplate>
            <views:NodeTemplateSelector.ForEachSlaveTemplate>
              <DataTemplate x:DataType="stepvm:ForEachSlaveNodeViewModel">
                <nodify:Node Header="{Binding Title}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="LoopNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource NodeLoopBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="220">
                    <Grid ColumnDefinitions="86,*">
                      <TextBlock Grid.Column="0" Text="С:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding FromSlaveId}" FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="86,*">
                      <TextBlock Grid.Column="0" Text="По:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding ToSlaveId}" FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="86,*">
                      <TextBlock Grid.Column="0" Text="Шаг:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Step}" FontSize="12" />
                    </Grid>

                    <CheckBox Content="Стоп при ошибке"
                              IsChecked="{Binding StopOnError}"
                              FontSize="12" />

                    <Button Content="Редактировать тело"
                            x:CompileBindings="False"
                            Command="{Binding DataContext.OpenCompositeNodeBodyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Classes="ghost"
                            FontSize="12" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.ForEachSlaveTemplate>

            <views:NodeTemplateSelector.CheckRegisterEqualityTemplate>
              <DataTemplate x:DataType="stepvm:CheckRegisterEqualityNodeViewModel">
                <nodify:Node Header="{Binding Title}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="EqualityNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource NodeEqualityBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="230">
                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Slave ID:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <ComboBox Grid.Column="1"
                                IsVisible="{Binding IsConnected}"
                                ItemsSource="{Binding AvailableSlaves}"
                                SelectedItem="{Binding SelectedSlave}"
                                FontSize="12"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="1"
                               IsVisible="{Binding !IsConnected}"
                               Text="{Binding SlaveId}"
                               FontSize="12" />
                    </Grid>

                    <CheckBox Content="Slave из цикла"
                              IsChecked="{Binding UseCurrentSlaveId}"
                              FontSize="12" />

                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Адрес:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <ComboBox Grid.Column="1"
                                IsVisible="{Binding ShowRegisterSelector}"
                                ItemsSource="{Binding AvailableRegisters}"
                                SelectedItem="{Binding SelectedRegister}"
                                FontSize="12"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="1"
                               IsVisible="{Binding ShowAddressTextBox}"
                               Text="{Binding Address}"
                               FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="76,*">
                      <TextBlock Grid.Column="0" Text="Значение:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding ExpectedValue}" FontSize="12" />
                    </Grid>
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.CheckRegisterEqualityTemplate>

