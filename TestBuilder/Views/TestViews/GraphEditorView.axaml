            <views:NodeTemplateSelector.ClearArpCacheTemplate>
              <DataTemplate x:DataType="stepvm:ClearArpCacheNodeViewModel">
                <nodify:Node Header="{Binding Title}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="OperatorNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource NodeOperatorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="320">
                    <CheckBox Content="Run arpd.bat" IsChecked="{Binding RunArpdBat}" FontSize="12" />
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Bat path:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding ArpdBatPath}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Command:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Command}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Arguments:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Arguments}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Timeout ms:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="12" />
                    </Grid>
                    <CheckBox Content="Fail on error" IsChecked="{Binding FailOnError}" FontSize="12" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.ClearArpCacheTemplate>

            <views:NodeTemplateSelector.SendUdpSetMacTemplate>
