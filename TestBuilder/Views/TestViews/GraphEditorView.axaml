                  <StackPanel Margin="10,6,10,10" Spacing="7" Width="220">
                    <Grid ColumnDefinitions="86,*">
                      <TextBlock Grid.Column="0" Text="С:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding FromSlaveId}" FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="86,*">
                      <TextBlock Grid.Column="0" Text="По:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding ToSlaveId}" FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="86,*">
                      <TextBlock Grid.Column="0" Text="Шаг:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding Step}" FontSize="12" />
                    </Grid>

                    <CheckBox Content="Стоп при ошибке"
                              IsChecked="{Binding StopOnError}"
                              FontSize="12" />

                    <Button Content="Редактировать тело"
                            x:CompileBindings="False"
                            Command="{Binding DataContext.OpenCompositeNodeBodyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Classes="ghost"
                            FontSize="12" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
