                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding Title}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
