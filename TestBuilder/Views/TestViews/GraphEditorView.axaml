                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Target IP:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding TargetIp}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Target port:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding TargetPort}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="MAC var:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding MacVariableName}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Timeout ms:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="12" />
