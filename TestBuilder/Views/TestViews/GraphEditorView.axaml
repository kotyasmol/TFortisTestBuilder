<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             xmlns:nodify="using:Nodify"
             xmlns:nodifyvm="using:TestBuilder.ViewModels.NodifyVM"
             xmlns:stepvm="using:TestBuilder.ViewModels.StepVM"
             xmlns:views="using:TestBuilder.Views"
             xmlns:presentation="using:TestBuilder.Presentation"
             xmlns:converters="using:TestBuilder.Converters"
             xmlns:avaloniaConverters="using:Avalonia.Data.Converters"
             xmlns:testviews="using:TestBuilder.Views.TestViews"
             x:Name="Root"
             x:Class="TestBuilder.Views.TestViews.GraphEditorView"
             x:DataType="vm:TestViewModel">

  <UserControl.Resources>
    <ControlTheme x:Key="NodeHeaderButtonTheme" TargetType="Button">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource UiCornerRadius}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.7" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.5" />
      </Style>
    </ControlTheme>
    <converters:RussianUiTextConverter x:Key="RussianUiText" />
    <DataTemplate x:Key="RussianOptionTemplate" x:CompileBindings="False">
      <TextBlock Text="{Binding Converter={StaticResource RussianUiText}}" TextWrapping="Wrap" />
    </DataTemplate>

    <DataTemplate x:Key="NodeHeaderHelpTemplate"
                  x:DataType="nodifyvm:NodeViewModel">
      <DockPanel LastChildFill="True"
                 MinWidth="0">
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
          <Border Classes="nodeHelpTrigger"
                  Width="24"
                  Height="24"
                  Background="Transparent"
                  ToolTip.Tip="Информация о ноде"
                  IsVisible="{Binding HasHelpText}"
                  PointerPressed="OnNodeHelpPointerPressed"
                  VerticalAlignment="Center">
            <PathIcon Width="14"
                      Height="14"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Foreground="{Binding NodeHeaderTextBrush}"
                      Data="M11 10h2v7h-2z M11 7h2v2h-2z M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M12 4a8 8 0 1 1 0 16 8 8 0 0 1 0-16z" />
          </Border>
          <Button x:Name="NodeOptionsTrigger" Classes="nodeHeaderAction" Theme="{StaticResource NodeHeaderButtonTheme}" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="4"
                  Background="Transparent" Foreground="{Binding NodeHeaderTextBrush}"
                  ToolTip.Tip="Настройки ноды" AutomationProperties.Name="Настройки ноды"
                  IsEnabled="{Binding $parent[testviews:GraphEditorView].((vm:TestViewModel)DataContext).CanEditGraph}">
            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding NodeHeaderTextBrush}" StrokeThickness="1.8"
                  Data="M9 3 L15 3 L15.6 6 L18 7.4 L21 6.5 L24 11.5 L21.6 13.5 L21.6 16.3 L24 18.3 L21 23.3 L18 22.4 L15.6 23.8 L15 27 L9 27 L8.4 23.8 L6 22.4 L3 23.3 L0 18.3 L2.4 16.3 L2.4 13.5 L0 11.5 L3 6.5 L6 7.4 L8.4 6 Z M16 15 A4 4 0 1 1 8 15 A4 4 0 1 1 16 15" />
            <Button.Flyout><Flyout><StackPanel Spacing="8" Width="290" IsEnabled="{Binding #NodeOptionsTrigger.IsEnabled}">
              <TextBlock Text="Название ноды" />
              <TextBox x:Name="CustomNodeNameInput" Text="{Binding CustomName, Mode=TwoWay}" Watermark="Необязательно"
                       ToolTip.Tip="Название в редакторе и пульте. Очистите поле, чтобы вернуть стандартное название." />
              <TextBlock Text="Элементы платы через запятую" TextWrapping="Wrap" />
              <TextBox Text="{Binding BoardElements}" Watermark="VCC, K5" />
            </StackPanel></Flyout></Button.Flyout>
          </Button>
          <Button x:Name="ColorPickerTrigger"
                  Classes="nodeColorTrigger nodeHeaderAction"
                  Theme="{StaticResource NodeHeaderButtonTheme}" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="4"
                  Background="Transparent" Foreground="{Binding NodeHeaderTextBrush}"
                  ToolTip.Tip="Изменить цвет ноды" AutomationProperties.Name="Изменить цвет ноды">
            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding NodeHeaderTextBrush}" StrokeThickness="1.8"
                   StrokeLineCap="Round"
                  Data="M14 5 L17 2 Q19 0 21 2 Q23 4 21 6 L18 9 M12 5 L19 12 M14 7 L4 17 L3 21 L7 20 L17 10 M5 16 L8 19" />
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <Border Padding="8"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <UniformGrid Columns="4">
                    <Button Classes="nodeColorChoice colorSwatch" Background="#3B82F6" ToolTip.Tip="Синий" Command="{Binding SelectColorCommand}" CommandParameter="blue" />
                    <Button Classes="nodeColorChoice colorSwatch" Background="#14B8A6" ToolTip.Tip="Бирюзовый" Command="{Binding SelectColorCommand}" CommandParameter="turquoise" />
                    <Button Classes="nodeColorChoice colorSwatch" Background="#22C55E" ToolTip.Tip="Зелёный" Command="{Binding SelectColorCommand}" CommandParameter="green" />
                    <Button Classes="nodeColorChoice colorSwatch" Background="#EAB308" ToolTip.Tip="Жёлтый" Command="{Binding SelectColorCommand}" CommandParameter="yellow" />
                    <Button Classes="nodeColorChoice colorSwatch" Background="#F97316" ToolTip.Tip="Оранжевый" Command="{Binding SelectColorCommand}" CommandParameter="orange" />
                    <Button Classes="nodeColorChoice colorSwatch" Background="#EF4444" ToolTip.Tip="Красный" Command="{Binding SelectColorCommand}" CommandParameter="red" />
                    <Button Classes="nodeColorChoice colorSwatch" Background="#A855F7" ToolTip.Tip="Фиолетовый" Command="{Binding SelectColorCommand}" CommandParameter="purple" />
                  </UniformGrid>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <StackPanel Spacing="4">
          <Border IsVisible="{Binding IsRunStart}" HorizontalAlignment="Left" Background="{DynamicResource SurfaceBrush}" CornerRadius="{StaticResource UiCornerRadius}" Padding="6,3">
            <TextBlock Text="{Binding RunStartLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold" />
          </Border>
        <TextBlock Text="{Binding DisplayTitle}"
                   MaxWidth="320"
                   TextWrapping="Wrap"
                   LineHeight="17"
                   FontWeight="SemiBold"
                   Foreground="{Binding NodeHeaderTextBrush}"
                   VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </DataTemplate>

  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="CheckBox.profileOpenToggle" x:DataType="nodifyvm:NodeViewModel">
      <Setter Property="Content" Value="При открытии профиля" />
      <Setter Property="ContentTemplate">
        <DataTemplate x:DataType="x:String">
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </Setter>
      <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="IsChecked" Value="{Binding RunOnlyOnFirstRun, Mode=TwoWay}" />
      <Setter Property="IsEnabled" Value="{Binding $parent[testviews:GraphEditorView].((vm:TestViewModel)DataContext).CanEditGraph}" />
      <Setter Property="IsVisible">
        <MultiBinding Converter="{x:Static avaloniaConverters:BoolConverters.And}">
          <Binding Path="CanRunOnlyOnFirstRun" />
          <Binding Path="!$parent[testviews:GraphEditorView].((vm:TestViewModel)DataContext).IsActionGraphEditor" />
        </MultiBinding>
      </Setter>
      <Setter Property="ToolTip.Tip" Value="Выполнять при каждом открытии профиля. Разместите отмеченные ноды подряд после «Старт» основного графа. При обычных запусках теста пропускать. Подтест и цикл выполняются целиком." />
    </Style>
    <Style Selector="nodify|Node.inactive">
      <Setter Property="Background" Value="{DynamicResource InactiveNodeBackgroundBrush}" />
      <Setter Property="ContentBrush" Value="{DynamicResource InactiveNodeBackgroundBrush}" />
      <Setter Property="FooterBrush" Value="{DynamicResource InactiveNodeBackgroundBrush}" />
    </Style>
    <Style Selector="nodify|Node.inactive TextBox, nodify|Node.inactive ComboBox, nodify|Node.inactive NumericUpDown, nodify|Node.inactive Button, nodify|Node.inactive CheckBox">
      <Setter Property="Background" Value="{DynamicResource InactiveNodeFieldBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="AutoCompleteBox.profileIdentity /template/ TextBox">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Keep the running graph readable and navigable without disabled-control dimming. -->
    <Style Selector="nodify|NodifyEditor.inspectOnly TextBox">
      <Setter Property="IsReadOnly" Value="True" />
    </Style>
    <Style Selector="nodify|NodifyEditor.inspectOnly ComboBox, nodify|NodifyEditor.inspectOnly CheckBox, nodify|NodifyEditor.inspectOnly Button.nodeColorTrigger">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="nodify|NodifyEditor.inspectOnly :is(nodify|Connector)">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="nodify|NodifyEditor.inspectOnly nodify|ItemContainer">
      <Setter Property="IsDraggable" Value="False" />
    </Style>

    <Style Selector="Border.nodeHelpTrigger">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.nodeHelpTrigger:pointerover PathIcon">
      <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style Selector="Button.nodeColorChoice">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Padding="12,12,12,4" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto">
        <Grid ColumnDefinitions="Auto,Auto,200,Auto,*" Margin="0,0,0,6" IsVisible="{Binding !IsActionGraphEditor}">
          <Button Command="{Binding ToggleProfilesCommand}" ToolTip.Tip="{Binding ProfilesToggleTip}" AutomationProperties.Name="{Binding ProfilesToggleTip}" Margin="0,0,10,0" Padding="8,6">
            <PathIcon Width="18" Height="18" Data="M3 3 H21 V21 H3 Z M5 5 V19 H8 V5 Z M10 5 V19 H19 V5 Z" />
          </Button>
          <TextBlock Grid.Column="1" Text="Устройство" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" />
          <AutoCompleteBox x:Name="DeviceNameInput" Classes="profileIdentity" DataContextChanged="OnProfileFieldDataContextChanged" LostFocus="OnProfileFieldLostFocus" KeyDown="OnProfileFieldKeyDown" Grid.Column="2" Margin="0,0,12,0" ItemsSource="{Binding DeviceNameSuggestions}"
                   Text="{Binding DeviceName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Watermark="Устройство"
                   FilterMode="ContainsOrdinal" IsTextCompletionEnabled="False" MinimumPrefixLength="1"
                   Padding="10,5" MinHeight="32" IsEnabled="{Binding CanEditGraph}" AutomationProperties.Name="Устройство"
                   ToolTip.Tip="Выберите устройство или введите новое название. После сохранения появится раздел с этим названием." />
          <TextBlock Grid.Column="3" Text="·" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
          <AutoCompleteBox x:Name="ProfileNameInput" Classes="profileIdentity" DataContextChanged="OnProfileFieldDataContextChanged" LostFocus="OnProfileFieldLostFocus" KeyDown="OnProfileFieldKeyDown" Grid.Column="4" ItemsSource="{Binding ProfileNameSuggestions}"
                   Text="{Binding ProfileDescription, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Watermark="Название проверки"
                   FilterMode="ContainsOrdinal" IsTextCompletionEnabled="False" MinimumPrefixLength="1"
                   Padding="10,5" MinHeight="32" IsEnabled="{Binding CanEditGraph}" AutomationProperties.Name="Название профиля"
                   ToolTip.Tip="Полное имя: устройство · название проверки. Новое название и «Сохранить» создают копию. С прежним названием обновляется открытый профиль." />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,8" IsVisible="{Binding CanGoBackGraph}">
          <Button Command="{Binding GoBackGraphCommand}" IsEnabled="{Binding CanGoBackGraph}" ToolTip.Tip="Назад к родительскому графу" AutomationProperties.Name="Назад к родительскому графу" Padding="9,8"><PathIcon Width="18" Height="18" Data="M10 4 L3 11 10 18 12 16 8 12 21 12 21 10 8 10 12 6 Z" /></Button>
          <TextBlock Grid.Column="1" Text="{Binding CurrentGraphPath}" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding CurrentGraphPath}" Margin="12,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <WrapPanel Grid.Row="2" Classes="actions" Name="GraphActions">
          <TextBlock IsVisible="{Binding !IsActionGraphEditor}" Text="Тип изделия" VerticalAlignment="Center" Margin="0,0,6,8" />
          <ComboBox IsVisible="{Binding !IsActionGraphEditor}" x:Name="ProfileProductKindInput" ItemsSource="{Binding ProductKinds}"
                    SelectedItem="{Binding ProfileProductKind, Mode=TwoWay}" IsEnabled="{Binding CanEditGraph}"
                    MinWidth="145" Margin="0,0,12,8" VerticalContentAlignment="Center" AutomationProperties.Name="Тип изделия"
                    ToolTip.Tip="Тип сохраняется в профиле и определяет доступные разделы программы." />
          <Button IsVisible="{Binding !IsActionGraphEditor}" Command="{Binding RunGraphCommand}" Classes="primary" ToolTip.Tip="Запустить тест" AutomationProperties.Name="Запустить тест" Padding="9,8"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="18" Height="18" Data="M6 3 L21 12 6 21 Z" /><TextBlock Text="Запустить" Foreground="{Binding $parent[Button].Foreground}" /></StackPanel></Button>
          <Button IsVisible="{Binding ShowRetryProfilePreparation}" Command="{Binding RetryProfilePreparationCommand}" Classes="primary" Content="Повторить настройку" AutomationProperties.Name="Повторить настройку" Padding="9,8" />
          <Button Command="{Binding PauseTestCommand}" IsVisible="{Binding IsTestRunning}" ToolTip.Tip="Пауза" AutomationProperties.Name="Пауза" Padding="9,8"><PathIcon Width="18" Height="18" Data="M5 3 H10 V21 H5 Z M14 3 H19 V21 H14 Z" /></Button>
          <Button Command="{Binding ResumeTestCommand}" IsVisible="{Binding IsTestPaused}" Classes="primary" ToolTip.Tip="Продолжить" AutomationProperties.Name="Продолжить" Padding="9,8"><PathIcon Width="18" Height="18" Data="M6 3 L21 12 6 21 Z" /></Button>
          <Button Command="{Binding StopTestCommand}" IsVisible="{Binding IsTestRunning}" Classes="danger" ToolTip.Tip="Остановить" AutomationProperties.Name="Остановить" Padding="9,8"><PathIcon Width="18" Height="18" Data="M4 4 H20 V20 H4 Z" /></Button>
          <Button IsVisible="{Binding !IsActionGraphEditor}" Command="{Binding SaveGraphCommand}"  ToolTip.Tip="Сохранить профиль" AutomationProperties.Name="Сохранить профиль" Padding="9,8"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="18" Height="18" Data="M3 3 H18 L21 6 V21 H3 Z M6 4 V10 H17 V4 Z M6 14 V20 H18 V14 Z" /><TextBlock Text="Сохранить" /></StackPanel></Button>
          <Button Command="{Binding UndoCommand}"  ToolTip.Tip="Отменить (Ctrl / Cmd + Z)" AutomationProperties.Name="Отменить (Ctrl / Cmd + Z)" Padding="9,8"><PathIcon Width="18" Height="18" Data="M7 3 L1 9 7 15 V11 H14 C19 11 20 17 16 20 C24 19 24 7 14 7 H7 Z" /></Button>
          <Button Command="{Binding RedoCommand}"  ToolTip.Tip="Повторить (Ctrl + Y / Cmd + Shift + Z)" AutomationProperties.Name="Повторить (Ctrl + Y / Cmd + Shift + Z)" Padding="9,8"><PathIcon Width="18" Height="18" Data="M17 3 L23 9 17 15 V11 H10 C5 11 4 17 8 20 C0 19 0 7 10 7 H17 Z" /></Button>
          <Button Command="{Binding ClearGraphCommand}" Content="Очистить граф" ToolTip.Tip="Удалить все ноды графа" Padding="9,8" />
          <Button Content="Пинг" Click="OnConfigurePing" IsVisible="{Binding ShowQuickActionTools}" IsEnabled="{Binding CanEditQuickActions}"
                  ToolTip.Tip="Адрес, период опроса и отображение в профиле" AutomationProperties.Name="Настройки пинга профиля" Padding="9,8" />
          <Button Content="Аварийные действия" Click="OnConfigureFailureCleanup"
                  IsVisible="{Binding ShowQuickActionTools}" IsEnabled="{Binding CanEditQuickActions}"
                  ToolTip.Tip="Порядок выполнения при ошибке и остановке" AutomationProperties.Name="Порядок аварийных действий" Padding="9,8" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,8">
          <Button Click="OnZoomOutClick" ToolTip.Tip="Уменьшить масштаб" AutomationProperties.Name="Уменьшить масштаб" Padding="9,8"><PathIcon Width="18" Height="18" Data="M4 11 H20 V13 H4 Z" /></Button>
          <Button Click="OnZoomInClick" ToolTip.Tip="Увеличить масштаб" AutomationProperties.Name="Увеличить масштаб" Padding="9,8"><PathIcon Width="18" Height="18" Data="M11 4 H13 V11 H20 V13 H13 V20 H11 V13 H4 V11 H11 Z" /></Button>
          <Button Click="OnCenterGraphClick" ToolTip.Tip="Центрировать граф" AutomationProperties.Name="Центрировать граф" Padding="9,8"><PathIcon Width="18" Height="18" Data="M2 2 H9 V4 H4 V9 H2 Z M15 2 H22 V9 H20 V4 H15 Z M2 15 H4 V20 H9 V22 H2 Z M20 15 H22 V22 H15 V20 H20 Z M8 8 H16 V16 H8 Z" /></Button>
          <TextBlock Text="{Binding ViewportZoom, ElementName=Editor, StringFormat={}{0:0%}}" VerticalAlignment="Center" Margin="4,0,0,0" />
          </StackPanel>
        </WrapPanel>
        <Border Grid.Row="3" IsVisible="{Binding HasPartialRun}" Background="{DynamicResource PrimarySoftBrush}"
                CornerRadius="8" Padding="10" Margin="0,4,0,0">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Text="{Binding PartialRunCaption}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="С начала" Command="{Binding ClearPartialRunCommand}" Margin="12,0,0,0"
                    ToolTip.Tip="Сбросить временный старт и запускать весь профиль" />

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="6" Margin="0,6,0,0">
              <TextBlock Text="{Binding PartialRunHint}" Classes="hint" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Адрес устройства (если нужен)" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding RunSlaveId}" Minimum="1" Maximum="247" Increment="1" FormatString="0"
                               Width="160" IsEnabled="{Binding CanEditGraph}" Watermark="Не задан" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" x:Name="GraphWorkspace" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*,Auto" ClipToBounds="True">
      <views:RegisterIndicatorsView x:Name="GraphRegisterIndicators" Grid.ColumnSpan="3" WorkspaceHeight="{Binding #GraphWorkspace.Bounds.Height}" />
      <views:ProfileActionBar x:Name="GraphQuickActions" Grid.Row="1" />
      <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource EditorBackgroundBrush}" IsHitTestVisible="False">
        <testviews:GraphDotBackground
            ViewportLocation="{Binding #Editor.ViewportLocation}"
            ViewportZoom="{Binding #Editor.ViewportZoom}"
            DotBrush="{DynamicResource EditorDotBrush}" />
      </Border>
      <nodify:NodifyEditor x:Name="Editor" Grid.Column="1" Grid.Row="1"
                           Classes.inspectOnly="{Binding !CanEditGraph}"
                           ItemsSource="{Binding Nodes}"
                           Connections="{Binding Connections}"
                           PendingConnection="{Binding PendingConnection}"
                           DisplayConnectionsOnTop="False"
                           DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                           SelectedItems="{Binding SelectedNodes}"
                           Background="Transparent"
                           GridCellSize="16"
                           DragDrop.AllowDrop="True">

        <nodify:NodifyEditor.ItemContainerTheme>
          <ControlTheme TargetType="nodify:ItemContainer"
                        BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
            <Setter Property="Location"
                    Value="{Binding Location}"
                    x:DataType="nodifyvm:NodeViewModel" />
            <Setter Property="BorderBrush"
                    Value="{Binding ExecutionBorderBrush}"
                    x:DataType="nodifyvm:NodeViewModel" />
            <Setter Property="BorderThickness"
                    Value="{Binding ExecutionBorderThickness}"
                    x:DataType="nodifyvm:NodeViewModel" />
          </ControlTheme>
        </nodify:NodifyEditor.ItemContainerTheme>

        <nodify:NodifyEditor.ItemTemplate>
          <views:NodeTemplateSelector>

            <views:NodeTemplateSelector.DefaultTemplate>
              <DataTemplate x:DataType="nodifyvm:NodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="LabelNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>
                  <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" Margin="12" />
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.DefaultTemplate>

            <views:NodeTemplateSelector.ModbusWriteTemplate>
              <DataTemplate x:DataType="stepvm:ModbusWriteNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="ModbusNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="8" Width="280">
                    <TextBlock Text="Область Modbus" />
                    <ComboBox ItemsSource="{Binding RegisterAreas}" ItemTemplate="{StaticResource RussianOptionTemplate}" SelectedItem="{Binding RegisterArea}" HorizontalAlignment="Stretch" />
                    <Grid ColumnDefinitions="108,*,Auto">
                      <TextBlock Grid.Column="0" Text="Адрес устройства:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <ComboBox Grid.Column="1"
                                IsVisible="{Binding IsConnected}"
                                ItemsSource="{Binding AvailableSlaves}"
                                SelectedItem="{Binding SelectedSlave}"
                                FontSize="{StaticResource FontCaption}"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="{StaticResource FontCaption}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="1"
                               IsVisible="{Binding !IsConnected}"
                               Text="{Binding SlaveIdText}"
                               FontSize="{StaticResource FontCaption}" />
                      <StackPanel Grid.Column="2"
                                  Orientation="Horizontal"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Center">
                        <TextBlock Text="Адрес "
                                   FontSize="{StaticResource FontCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SlaveId}"
                                   FontSize="{StaticResource FontCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                      </StackPanel>
                    </Grid>

                    <CheckBox
                              IsChecked="{Binding UseCurrentSlaveId}"
                              FontSize="{StaticResource FontCaption}" ><TextBlock Text="Устройство из цикла" TextWrapping="Wrap" /></CheckBox>

                    <Grid ColumnDefinitions="50,*,70">
                      <TextBlock Grid.Column="0" Text="Адрес:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <ComboBox Grid.Column="1"
                                IsVisible="{Binding ShowRegisterSelector}"
                                ItemsSource="{Binding AvailableRegisters}"
                                SelectedItem="{Binding SelectedRegister}"
                                FontSize="{StaticResource FontCaption}"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" ToolTip.Tip="{Binding}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource FontCaption}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="2" Margin="4,0,0,0"
                               IsVisible="{Binding ShowAddressTextBox}"
                               Text="{Binding AddressText}"
                               FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <SelectableTextBlock Text="{Binding RegisterDescription}" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RegisterDescription}"
                                         FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />


                    <Grid ColumnDefinitions="108,*">
                      <TextBlock Grid.Column="0" Text="Значение:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding ValueText}" FontSize="{StaticResource FontCaption}" />
                    </Grid>

                    <TextBlock Text="{Binding IntegerInputError}"
                               IsVisible="{Binding HasIntegerInputError}"
                               FontSize="{StaticResource FontCaption}"
                               Foreground="{DynamicResource DangerTextBrush}"
                               TextWrapping="Wrap" />

                    <CheckBox
                              IsChecked="{Binding VerifyWrite}"
                              FontSize="{StaticResource FontCaption}" ><TextBlock Text="Проверка" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.ModbusWriteTemplate>

            <views:NodeTemplateSelector.SelfTestCheckTemplate>
              <DataTemplate x:DataType="stepvm:SelfTestCheckNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="HttpNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="8" Width="320">
                    <Grid ColumnDefinitions="88,*">
                      <TextBlock Grid.Column="0" Text="Адрес страницы:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Url}"
                               FontSize="{StaticResource FontCaption}"
                               Watermark="http://192.168.0.1/cgi-bin/luci/admin/statistics/deviceinfo?..." />
                    </Grid>

                    <Grid ColumnDefinitions="88,*">
                      <TextBlock Grid.Column="0" Text="Таймаут, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="{StaticResource FontCaption}" />
                    </Grid>

                    <Grid ColumnDefinitions="88,*">
                      <TextBlock Grid.Column="0" Text="Период опроса, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding PollIntervalMs}" FontSize="{StaticResource FontCaption}" />
                    </Grid>

                    <Grid ColumnDefinitions="88,*">
                      <TextBlock Grid.Column="0" Text="Префикс переменных:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding OutputPrefix}" FontSize="{StaticResource FontCaption}" />
                    </Grid>

                    <Grid ColumnDefinitions="88,*">
                      <TextBlock Grid.Column="0" Text="Допуски:" VerticalAlignment="Top" Margin="0,5,0,0" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" />
                      <TextBox Grid.Column="1"
                               Text="{Binding ValidationRules}"
                               FontSize="{StaticResource FontCaption}"
                               TextWrapping="NoWrap"
                               AcceptsReturn="True"
                               Height="118" />
                    </Grid>

                    <CheckBox
                              ToolTip.Tip="Дополнительные проверки аппаратуры PSW-2G6F+. Адрес test.shtml задаётся отдельно в URL."
                              IsChecked="{Binding Psw2G6FHardwareChecks}"
                              FontSize="{StaticResource FontCaption}" ><TextBlock Text="Проверять питание, SFP и PoE PSW-2G6F+" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox
                              IsChecked="{Binding FailOnError}"
                              FontSize="{StaticResource FontCaption}" ><TextBlock Text="Критическая ошибка при провале" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.SelfTestCheckTemplate>
            <views:NodeTemplateSelector.GetSerialNumberTemplate>
              <DataTemplate x:DataType="stepvm:GetSerialNumberFromServerNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="HttpNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="8" Width="340">
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Сервер:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1"
                               Text="{Binding ServerBaseUrl}"
                               FontSize="{StaticResource FontCaption}"
                               Watermark="Пусто — адрес сервера из настроек" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Тип изделия:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1"
                               Text="{Binding DeviceType}"
                               FontSize="{StaticResource FontCaption}"
                               Watermark="PSW+UPS-Box 8x2Pro" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Переменная идентификатора процессора:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1"
                               Text="{Binding CpuIdVariableName}"
                               FontSize="{StaticResource FontCaption}"
                               Watermark="Dut.cpu_id" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Переменная результата:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1"
                               Text="{Binding OutputVariableName}"
                               FontSize="{StaticResource FontCaption}"
                               Watermark="SerialNumber" />
                    </Grid>

                    <CheckBox
                              IsChecked="{Binding UseFixedSerialNumber}"
                              FontSize="{StaticResource FontCaption}" ><TextBlock Text="Отладка: не обращаться к серверу" TextWrapping="Wrap" /></CheckBox>

                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Отладочный серийный номер:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1"
                               Text="{Binding FixedSerialNumber}"
                               IsEnabled="{Binding UseFixedSerialNumber}"
                               FontSize="{StaticResource FontCaption}" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Таймаут, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="{StaticResource FontCaption}" />
                    </Grid>

                    <Grid ColumnDefinitions="96,*,8,*">
                      <TextBlock Grid.Column="0" Text="Повторы:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding RetryCount}" FontSize="{StaticResource FontCaption}" />
                      <TextBox Grid.Column="3" Text="{Binding RetryDelayMs}" FontSize="{StaticResource FontCaption}" Watermark="Задержка, мс" />
                    </Grid>

                    <CheckBox
                              IsChecked="{Binding FailOnError}"
                              FontSize="{StaticResource FontCaption}" ><TextBlock Text="Критическая ошибка при провале" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.GetSerialNumberTemplate>
            <views:NodeTemplateSelector.CheckVariableEqualityTemplate>
              <DataTemplate x:DataType="stepvm:CheckVariableEqualityNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="EqualityNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="8" Width="300">
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Переменная:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding VariableName}" FontSize="{StaticResource FontCaption}" Watermark="Dut.init_ok" />
                    </Grid>
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Ожидаемое значение:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding ExpectedValue}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Тип сравнения:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <ComboBox Grid.Column="1" FontSize="{StaticResource FontCaption}"  ItemsSource="{x:Static presentation:RussianUiOptions.ComparisonTypes}" SelectedItem="{Binding ComparisonType, Mode=TwoWay}" ItemTemplate="{StaticResource RussianOptionTemplate}" HorizontalAlignment="Stretch" />
                    </Grid>
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Сообщение об ошибке:" VerticalAlignment="Top" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding FailMessage}" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap" AcceptsReturn="True" Height="52" />
                    </Grid>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.CheckVariableEqualityTemplate>

            <views:NodeTemplateSelector.CheckVariableRangeTemplate>
              <DataTemplate x:DataType="stepvm:CheckVariableRangeNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="RangeNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="8" Width="300">
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Переменная:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding VariableName}" FontSize="{StaticResource FontCaption}" Watermark="Dut.akb_voltage" />
                    </Grid>
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Минимум:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding Min}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Максимум:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding Max}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <CheckBox  IsChecked="{Binding Inclusive}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Включая границы" TextWrapping="Wrap" /></CheckBox>
                    <Grid ColumnDefinitions="96,*">
                      <TextBlock Grid.Column="0" Text="Сообщение об ошибке:" VerticalAlignment="Top" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding FailMessage}" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap" AcceptsReturn="True" Height="52" />
                    </Grid>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.CheckVariableRangeTemplate>

            <views:NodeTemplateSelector.CheckRegisterRangeTemplate>
              <DataTemplate x:DataType="stepvm:CheckRegisterRangeNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="RangeNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="8" Width="280">
                    <TextBlock Text="Область Modbus" />
                    <ComboBox ItemsSource="{Binding RegisterAreas}" ItemTemplate="{StaticResource RussianOptionTemplate}" SelectedItem="{Binding RegisterArea}" HorizontalAlignment="Stretch" />
                    <Grid ColumnDefinitions="108,*,Auto">
                      <TextBlock Grid.Column="0" Text="Адрес устройства:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <ComboBox Grid.Column="1"
                                IsVisible="{Binding IsConnected}"
                                ItemsSource="{Binding AvailableSlaves}"
                                SelectedItem="{Binding SelectedSlave}"
                                FontSize="{StaticResource FontCaption}"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="{StaticResource FontCaption}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="1"
                               IsVisible="{Binding !IsConnected}"
                               Text="{Binding SlaveId}"
                               FontSize="{StaticResource FontCaption}" />
                      <StackPanel Grid.Column="2"
                                  Orientation="Horizontal"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Center">
                        <TextBlock Text="Адрес "
                                   FontSize="{StaticResource FontCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SlaveId}"
                                   FontSize="{StaticResource FontCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                      </StackPanel>
                    </Grid>

                    <CheckBox
                              IsChecked="{Binding UseCurrentSlaveId}"
                              FontSize="{StaticResource FontCaption}" ><TextBlock Text="Устройство из цикла" TextWrapping="Wrap" /></CheckBox>

                    <CheckBox
                              IsChecked="{Binding LiveRead}"
                              FontSize="{StaticResource FontCaption}" ><TextBlock Text="Прямое чтение устройства" TextWrapping="Wrap" /></CheckBox>

                    <Grid ColumnDefinitions="108,*">
                      <TextBlock Grid.Column="0" Text="Попыток:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding ReadAttempts}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <TextBlock Text="Измерение в отчёте (необязательно):" FontSize="{StaticResource FontCaption}" />
                    <TextBox Text="{Binding ReportName}" Watermark="Название измерения" FontSize="{StaticResource FontCaption}" />

                    <Grid ColumnDefinitions="108,*">
                      <TextBlock Grid.Column="0" Text="Пауза, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding ReadIntervalMs}" FontSize="{StaticResource FontCaption}" />
                    </Grid>

                    <Grid ColumnDefinitions="50,*,70">
                      <TextBlock Grid.Column="0" Text="Адрес:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <ComboBox Grid.Column="1"
                                IsVisible="{Binding ShowRegisterSelector}"
                                ItemsSource="{Binding AvailableRegisters}"
                                SelectedItem="{Binding SelectedRegister}"
                                FontSize="{StaticResource FontCaption}"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" ToolTip.Tip="{Binding}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource FontCaption}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="2" Margin="4,0,0,0"
                               IsVisible="{Binding ShowAddressTextBox}"
                               Text="{Binding Address}"
                               FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <SelectableTextBlock Text="{Binding RegisterDescription}" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RegisterDescription}"
                                         FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />


                    <Grid ColumnDefinitions="108,*">
                      <TextBlock Grid.Column="0" Text="Минимум:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding Min}" FontSize="{StaticResource FontCaption}" />
                    </Grid>

                    <Grid ColumnDefinitions="108,*">
                      <TextBlock Grid.Column="0" Text="Максимум:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding Max}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.CheckRegisterRangeTemplate>

            <views:NodeTemplateSelector.DelayTemplate>
              <DataTemplate x:DataType="stepvm:DelayNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
