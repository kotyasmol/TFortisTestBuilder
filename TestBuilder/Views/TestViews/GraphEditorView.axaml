            <views:NodeTemplateSelector.LabelTemplate>
              <DataTemplate x:DataType="stepvm:LabelNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="LabelNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <Grid Margin="12"
                        Width="{Binding LabelWidth}"
                        Height="{Binding LabelHeight}"
                        MinWidth="190"
                        MinHeight="88">
                    <TextBox Text="{Binding Text}"
                             FontSize="{StaticResource FontBody}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch"
                             Padding="6,4,18,18" />
                    <Border Width="16"
                            Height="16"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#00000000"
                            PointerPressed="OnLabelResizePointerPressed"
                            PointerMoved="OnLabelResizePointerMoved"
                            PointerReleased="OnLabelResizePointerReleased">
                      <Border Width="8"
                              Height="8"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              BorderBrush="{DynamicResource TextSecondaryBrush}"
                              BorderThickness="0,0,2,2" />
                    </Border>
                  </Grid>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.LabelTemplate>

            <views:NodeTemplateSelector.SubtestTemplate>
              <DataTemplate x:DataType="stepvm:SubtestNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="SubtestNode"
                             Classes.inactive="{Binding IsInactive}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="8" Width="240">
                    <Grid ColumnDefinitions="78,*">
                      <TextBlock Grid.Column="0" Text="Название:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding Name}" FontSize="{StaticResource FontCaption}" />
                    </Grid>

                    <TextBox Text="{Binding Description}"
                             FontSize="{StaticResource FontCaption}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Height="48"
                             Watermark="Описание" />

                    <Grid ColumnDefinitions="*,*">
                      <CheckBox Grid.Column="0"  IsChecked="{Binding IsEnabled}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Включен" TextWrapping="Wrap" /></CheckBox>
                      <CheckBox Grid.Column="1"  IsChecked="{Binding StopOnError}" FontSize="{StaticResource FontCaption}" Margin="8,0,0,0" ><TextBlock Text="Прервать тест при ошибке" TextWrapping="Wrap" /></CheckBox>
                    </Grid>

                    <CheckBox
                              IsChecked="{Binding RunOnFailure}"
                              FontSize="{StaticResource FontCaption}" ><TextBlock Text="Выполнять при ошибке и остановке" TextWrapping="Wrap" /></CheckBox>

                    <Button Content="Порядок выполнения…" Click="OnConfigureFailureCleanup" FontSize="{StaticResource FontCaption}"
                            IsEnabled="{Binding $parent[testviews:GraphEditorView].((vm:TestViewModel)DataContext).CanEditQuickActions}">
                      <Button.IsVisible>
                        <MultiBinding Converter="{x:Static avaloniaConverters:BoolConverters.And}">
                          <Binding Path="RunOnFailure" />
                          <Binding Path="!$parent[testviews:GraphEditorView].((vm:TestViewModel)DataContext).CanGoBackGraph" />
                          <Binding Path="$parent[testviews:GraphEditorView].((vm:TestViewModel)DataContext).ShowQuickActionTools" />
                        </MultiBinding>
                      </Button.IsVisible>
                    </Button>

                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />

                    <TextBlock Text="{Binding StepCount, StringFormat='Шагов: {0}'}"
                               FontSize="{StaticResource FontCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ProgressText, StringFormat='Сейчас: {0}'}"
                               IsVisible="{Binding HasProgress}"
                               FontSize="{StaticResource FontCaption}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource NodeWaitBrush}" />

                    <Button Content="Открыть"
                            x:CompileBindings="False"
                            Command="{Binding DataContext.OpenCompositeNodeBodyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Classes="ghost"
                            FontSize="{StaticResource FontCaption}" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.SubtestTemplate>
            <views:NodeTemplateSelector.SerialConsoleTemplate>
              <DataTemplate x:DataType="stepvm:SerialConsoleNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="LoopNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="6" Width="260">
                    <TextBlock Text="Устройство из оборудования профиля" TextWrapping="Wrap" />
                    <views:ConsoleDeviceSelector Devices="{Binding $parent[testviews:GraphEditorView].((vm:TestViewModel)DataContext).ConsoleDeviceChoices}"
                                                 DeviceId="{Binding DeviceId, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <StackPanel IsVisible="{Binding UsesLegacyConnection}" Spacing="6">
                      <TextBlock Text="Порт (пусто — из старых настроек)" TextWrapping="Wrap" />
                      <TextBox Text="{Binding PortName}" />
                      <TextBlock Text="Скорость" />
                      <TextBox Text="{Binding BaudRate}" />
                    </StackPanel>
                    <CheckBox Content="Дождаться подключения" IsChecked="{Binding ConnectOnly}" ToolTip.Tip="Ждать появления USB-UART и открыть порт без отправки команд" />
                    <StackPanel IsVisible="{Binding !ConnectOnly}" Spacing="6">
                    <TextBlock Text="Команда" TextWrapping="Wrap" />
                    <TextBox Text="{Binding Command}" AcceptsReturn="True" MinHeight="60" />
                    <TextBlock Text="Маркер конца (пусто — тишина)" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ResponseTerminator}" />
                    <TextBlock Text="Тишина, мс" TextWrapping="Wrap" />
                    <TextBox Text="{Binding QuietMs}" />
                    <TextBlock Text="Переменная ответа" TextWrapping="Wrap" />
                    <TextBox Text="{Binding OutputVariableName}" />
                    </StackPanel>
                    <TextBlock Text="Время ожидания, мс" TextWrapping="Wrap" />
                    <TextBox Text="{Binding TimeoutMs}" />
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.SerialConsoleTemplate>
            <views:NodeTemplateSelector.RunProgramTemplate>
              <DataTemplate x:DataType="stepvm:RunProgramNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="LoopNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="6" Width="260">
                    <TextBlock Text="Исполняемый файл" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ProgramPath}" />
                    <TextBlock Text="Аргументы: один на строку" TextWrapping="Wrap" />
                    <TextBox Text="{Binding Arguments}" AcceptsReturn="True" MinHeight="60" />
                    <TextBlock Text="Рабочая папка" TextWrapping="Wrap" />
                    <TextBox Text="{Binding WorkingDirectory}" />
                    <TextBlock Text="Таймаут, мс" TextWrapping="Wrap" />
                    <TextBox Text="{Binding TimeoutMs}" />
                    <TextBlock Text="Код успешного завершения" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ExpectedExitCode}" />
                    <TextBlock Text="Префикс переменных" TextWrapping="Wrap" />
                    <TextBox Text="{Binding OutputPrefix}" />
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.RunProgramTemplate>
            <views:NodeTemplateSelector.ParseResponseTemplate>
              <DataTemplate x:DataType="stepvm:ParseResponseNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="LoopNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="6" Width="260">
                    <TextBlock Text="Исходная переменная" TextWrapping="Wrap" />
                    <TextBox Text="{Binding SourceVariableName}" />
                    <TextBlock Text="Формат ответа" TextWrapping="Wrap" />
                    <ComboBox  ItemsSource="{x:Static presentation:RussianUiOptions.ParseModes}" SelectedItem="{Binding ParseMode, Mode=TwoWay}" ItemTemplate="{StaticResource RussianOptionTemplate}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Путь поля / регулярное выражение" TextWrapping="Wrap" />
                    <TextBox Text="{Binding Selector}" />
                    <TextBlock Text="Тип значения" TextWrapping="Wrap" />
                    <ComboBox  ItemsSource="{x:Static presentation:RussianUiOptions.ValueTypes}" SelectedItem="{Binding ValueType, Mode=TwoWay}" ItemTemplate="{StaticResource RussianOptionTemplate}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Переменная результата" TextWrapping="Wrap" />
                    <TextBox Text="{Binding OutputVariableName}" />
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.ParseResponseTemplate>
            <views:NodeTemplateSelector.CheckLedColorTemplate>
              <DataTemplate x:DataType="stepvm:CheckLedColorNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="LoopNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="6" Width="260">
                    <TextBlock Text="Адрес устройства" TextWrapping="Wrap" />
                    <TextBox Text="{Binding SlaveId}" />
                    <CheckBox IsChecked="{Binding UseCurrentSlaveId}" Content="Использовать устройство цикла" />
                    <TextBlock Text="Регистр красного канала" TextWrapping="Wrap" />
                    <TextBox Text="{Binding RedAddress}" />
                    <TextBlock Text="Регистр зелёного канала" TextWrapping="Wrap" />
                    <TextBox Text="{Binding GreenAddress}" />
                    <TextBlock Text="Регистр синего канала" TextWrapping="Wrap" />
                    <TextBox Text="{Binding BlueAddress}" />
                    <TextBlock Text="Регистр белого канала" TextWrapping="Wrap" />
                    <TextBox Text="{Binding WhiteAddress}" />
                    <TextBlock Text="Ожидаемый цвет" TextWrapping="Wrap" />
                    <ComboBox  ItemsSource="{x:Static presentation:RussianUiOptions.LedColors}" SelectedItem="{Binding ExpectedColor, Mode=TwoWay}" ItemTemplate="{StaticResource RussianOptionTemplate}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Разница каналов" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ColorMargin}" />
                    <TextBlock Text="Порог яркости" TextWrapping="Wrap" />
                    <TextBox Text="{Binding MinIntensity}" />
                    <TextBlock Text="Префикс результата" TextWrapping="Wrap" />
                    <TextBox Text="{Binding OutputPrefix}" />
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.CheckLedColorTemplate>
            <views:NodeTemplateSelector.ForEachSlaveTemplate>
              <DataTemplate x:DataType="stepvm:ForEachSlaveNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="LoopNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="8" Width="220">
                    <CheckBox IsChecked="{Binding RepeatOnSameSlave}" Content="Повтор на одном устройстве" />
                    <StackPanel IsVisible="{Binding RepeatOnSameSlave}" Spacing="6">
                      <TextBlock Text="Число повторов / имя счётчика" />
                      <TextBox Text="{Binding RepeatCount}" />
                      <TextBox Text="{Binding IndexVariable}" />
                      <CheckBox IsChecked="{Binding UntilSuccess}" Content="До первого успеха" />
                      <TextBlock Text="Пауза между повторами, мс" />
                      <TextBox Text="{Binding RepeatDelayMs}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="86,*">
                      <TextBlock Grid.Column="0" Text="С:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding FromSlaveId}" FontSize="{StaticResource FontCaption}" />
                    </Grid>

                    <Grid ColumnDefinitions="86,*">
                      <TextBlock Grid.Column="0" Text="По:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding ToSlaveId}" FontSize="{StaticResource FontCaption}" />
                    </Grid>

                    <Grid ColumnDefinitions="86,*">
                      <TextBlock Grid.Column="0" Text="Шаг:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding Step}" FontSize="{StaticResource FontCaption}" />
                    </Grid>

                    <CheckBox
                              IsChecked="{Binding StopOnError}"
                              FontSize="{StaticResource FontCaption}" ><TextBlock Text="Стоп при ошибке" TextWrapping="Wrap" /></CheckBox>

                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />

                    <Button Content="Редактировать тело"
                            x:CompileBindings="False"
                            Command="{Binding DataContext.OpenCompositeNodeBodyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Classes="ghost"
                            FontSize="{StaticResource FontCaption}" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.ForEachSlaveTemplate>

            <views:NodeTemplateSelector.WaitUntilTemplate>
              <DataTemplate x:DataType="stepvm:WaitUntilNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="WaitNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>
                  <StackPanel Margin="12" Spacing="8" Width="280">
                    <TextBlock Text="Область Modbus" />
                    <ComboBox ItemsSource="{Binding RegisterAreas}" ItemTemplate="{StaticResource RussianOptionTemplate}" SelectedItem="{Binding RegisterArea}" HorizontalAlignment="Stretch" />
                    <Grid ColumnDefinitions="108,*,Auto">
                      <TextBlock Grid.Column="0" Text="Адрес устройства:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <ComboBox Grid.Column="1" IsVisible="{Binding IsConnected}" ItemsSource="{Binding AvailableSlaves}" SelectedItem="{Binding SelectedSlave}" FontSize="{StaticResource FontCaption}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="{StaticResource FontCaption}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="1" IsVisible="{Binding !IsConnected}" Text="{Binding SlaveId}" FontSize="{StaticResource FontCaption}" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Адрес " FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SlaveId}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                      </StackPanel>
                    </Grid>
                    <CheckBox  IsChecked="{Binding UseCurrentSlaveId}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Устройство из цикла" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox  IsChecked="{Binding LiveRead}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Прямое чтение устройства" TextWrapping="Wrap" /></CheckBox>
                    <Grid ColumnDefinitions="50,*,70">
                      <TextBlock Grid.Column="0" Text="Адрес:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <ComboBox Grid.Column="1" IsVisible="{Binding ShowRegisterSelector}" ItemsSource="{Binding AvailableRegisters}" SelectedItem="{Binding SelectedRegister}" FontSize="{StaticResource FontCaption}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" ToolTip.Tip="{Binding}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource FontCaption}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBox Grid.Column="2" Margin="4,0,0,0" IsVisible="{Binding ShowAddressTextBox}" Text="{Binding Address}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <SelectableTextBlock Text="{Binding RegisterDescription}" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RegisterDescription}"
                                         FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />

                    <Grid ColumnDefinitions="108,*">
                      <TextBlock Grid.Column="0" Text="Значение:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding ExpectedValue}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="108,*">
                      <TextBlock Grid.Column="0" Text="Таймаут мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.WaitUntilTemplate>

            <views:NodeTemplateSelector.ClearArpCacheTemplate>
              <DataTemplate x:DataType="stepvm:ClearArpCacheNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="OperatorNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="8" Width="320">
                    <CheckBox  IsChecked="{Binding RunArpdBat}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Запускать файл arpd.bat" TextWrapping="Wrap" /></CheckBox>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Путь к командному файлу:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding ArpdBatPath}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Команда:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding Command}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Аргументы:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding Arguments}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Таймаут, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <CheckBox  IsChecked="{Binding FailOnError}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Ошибка ведёт по выходу «Нет»" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.ClearArpCacheTemplate>

            <views:NodeTemplateSelector.SetProMacTemplate>
              <DataTemplate x:DataType="stepvm:SetProMacNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="HttpNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="8" Width="340">
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Путь к командному файлу:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding BatchPath}" Watermark="set_mac_pro.bat" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Переменная MAC:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding MacVariableName}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Версия платы:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding BoardVersion}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Таймаут, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <CheckBox  IsChecked="{Binding FailOnError}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Ошибка ведёт по выходу «Нет»" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.SetProMacTemplate>

            <views:NodeTemplateSelector.SetPswMacTemplate>
              <DataTemplate x:DataType="stepvm:SetPswMacNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}" Output="{Binding Output}" Classes="HttpNode"
                             Background="{DynamicResource NodeBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}" BorderThickness="1" CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.OutputConnectorTemplate>
                  <StackPanel Margin="8" Spacing="6" Width="320">
                    <TextBlock Text="Отправка ≠ подтверждение записи MAC" TextWrapping="Wrap" FontSize="{StaticResource FontCaption}" />
                    <Grid ColumnDefinitions="110,*"><TextBlock Text="IPv4 устройства:" /><TextBox Grid.Column="1" Text="{Binding DestinationIp}" /></Grid>
                    <Grid ColumnDefinitions="110,*"><TextBlock Text="IPv4 стенда:" /><TextBox Grid.Column="1" Text="{Binding LocalIp}" /></Grid>
                    <Grid ColumnDefinitions="110,*"><TextBlock Text="Порт стенда:" /><TextBox Grid.Column="1" Text="{Binding LocalPort}" /></Grid>
                    <Grid ColumnDefinitions="110,*"><TextBlock Text="Порт UDP:" /><TextBox Grid.Column="1" Text="{Binding UdpPort}" /></Grid>
                    <Grid ColumnDefinitions="110,*"><TextBlock Text="Переменная MAC:" /><TextBox Grid.Column="1" Text="{Binding MacVariableName}" /></Grid>
                    <Grid ColumnDefinitions="110,*"><TextBlock Text="Таймаут, мс:" /><TextBox Grid.Column="1" Text="{Binding TimeoutMs}" /></Grid>
                    <CheckBox  IsChecked="{Binding FailOnError}" ><TextBlock Text="Ошибка ведёт по выходу «Нет»" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.SetPswMacTemplate>

            <views:NodeTemplateSelector.UpdatePswFirmwareTemplate>
              <DataTemplate x:DataType="stepvm:UpdatePswFirmwareNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}" Output="{Binding Output}" Classes="HttpNode"
                             Background="{DynamicResource NodeBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}" BorderThickness="1" CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.OutputConnectorTemplate>
                  <StackPanel Margin="8" Spacing="6" Width="390">
                    <TextBlock Text="Старые PSW: проверка версии, загрузка и повторная самопроверка" TextWrapping="Wrap" FontSize="{StaticResource FontCaption}" />
                    <Grid ColumnDefinitions="115,*"><TextBlock Text="Адрес устройства:" /><TextBox Grid.Column="1" Text="{Binding BaseUrl}" /></Grid>
                    <Grid ColumnDefinitions="115,*"><TextBlock Text="Файл .img:" /><TextBox Grid.Column="1" Text="{Binding FirmwarePath}" /></Grid>
                    <Grid ColumnDefinitions="115,*"><TextBlock Text="Версия:" /><TextBox Grid.Column="1" Text="{Binding TargetVersion}" /></Grid>
                    <Grid ColumnDefinitions="115,*"><TextBlock Text="Версия из:" /><TextBox Grid.Column="1" Text="{Binding VersionVariable}" /></Grid>
                    <CheckBox  IsChecked="{Binding ForceUpdate}" ><TextBlock Text="Прошивать даже при более новой версии" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.UpdatePswFirmwareTemplate>

            <views:NodeTemplateSelector.RunDataTestTemplate>
              <DataTemplate x:DataType="stepvm:RunDataTestNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="PollNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="8" Width="370">
                    <Grid ColumnDefinitions="128,*">
                      <TextBlock Grid.Column="0" Text="Режим:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding Mode, Converter={StaticResource RussianUiText}}" IsReadOnly="True" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="128,*">
                      <TextBlock Grid.Column="0" Text="Размер пакета, байт:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding PacketSizeBytes}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="128,*">
                      <TextBlock Grid.Column="0" Text="Порт UDP:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding UdpPort}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="128,*">
                      <TextBlock Grid.Column="0" Text="Длительность, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding DurationMs}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="128,*">
                      <TextBlock Grid.Column="0" Text="Прогрев, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding WarmupMs}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="128,*">
                      <TextBlock Grid.Column="0" Text="Пауза между парами, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding InterPairDelayMs}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="128,*">
                      <TextBlock Grid.Column="0" Text="Допустимые потери, %:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding AllowedLossPercent}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="128,*">
                      <TextBlock Grid.Column="0" Text="Недобор скорости передачи, %:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding AllowedTxDeficitPercent}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Grid ColumnDefinitions="128,*">
                      <TextBlock Grid.Column="0" Text="Переменная результата:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1" Text="{Binding OutputVariableName}" FontSize="{StaticResource FontCaption}" />
                    </Grid>
                    <Button Content="Настроить пары…" Command="{Binding EditPairsCommand}" />
                    <TextBlock Text="{Binding PairsSummary}" TextWrapping="Wrap" FontSize="{StaticResource FontCaption}" />
                    <Button Content="Взять пары из плана сети" Command="{Binding ImportNetworkPlanCommand}" />
                    <TextBlock Text="{Binding NetworkPlanStatus}" TextWrapping="Wrap" FontSize="{StaticResource FontCaption}" />
                    <CheckBox  IsChecked="{Binding Bidirectional}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Проверять оба направления" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox  IsChecked="{Binding FailOnError}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Ошибка ведёт по выходу «Нет»" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.RunDataTestTemplate>

            <views:NodeTemplateSelector.ReadHttpVariableTemplate>
              <DataTemplate x:DataType="stepvm:ReadHttpVariableNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}" Input="{Binding Input}" Output="{Binding Output}" Classes="HttpNode" Background="{DynamicResource NodeBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}" BorderThickness="1" CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.OutputConnectorTemplate>
                  <StackPanel Margin="12" Spacing="8" Width="350">
                    <Grid ColumnDefinitions="120,*"><TextBlock Grid.Column="0" Text="Базовый адрес:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding BaseUrl}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="120,*"><TextBlock Grid.Column="0" Text="Путь запроса:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding Endpoint}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="120,*"><TextBlock Grid.Column="0" Text="Тип ответа:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><ComboBox Grid.Column="1" ItemsSource="{Binding ResponseTypes}" ItemTemplate="{StaticResource RussianOptionTemplate}" SelectedItem="{Binding ResponseType, Mode=TwoWay}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="120,*"><TextBlock Grid.Column="0" Text="Таймаут, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="120,*"><TextBlock Grid.Column="0" Text="Переменная результата:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding OutputVariableName}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <CheckBox  IsChecked="{Binding FailOnError}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Ошибка ведёт по выходу «Нет»" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.ReadHttpVariableTemplate>

            <views:NodeTemplateSelector.BuildMacFromSerialTemplate>
              <DataTemplate x:DataType="stepvm:BuildMacFromSerialNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}" Input="{Binding Input}" Output="{Binding Output}" Classes="OperatorNode" Background="{DynamicResource NodeBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}" BorderThickness="1" CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.OutputConnectorTemplate>
                  <StackPanel Margin="12" Spacing="8" Width="340">
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Переменная серийного номера:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding SerialVariableName}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Смещение серийного номера:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding SerialOffset}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Префикс MAC:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding MacPrefix}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Переменная короткого номера:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding SerialShortVariableName}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Переменная MAC:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding MacVariableName}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <CheckBox  IsChecked="{Binding FailOnError}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Ошибка ведёт по выходу «Нет»" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.BuildMacFromSerialTemplate>

            <views:NodeTemplateSelector.CompareVariablesTemplate>
              <DataTemplate x:DataType="stepvm:CompareVariablesNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}" Input="{Binding Input}" Output="{Binding Output}" Classes="EqualityNode" Background="{DynamicResource NodeBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}" BorderThickness="1" CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.OutputConnectorTemplate>
                  <StackPanel Margin="12" Spacing="8" Width="320">
                    <Grid ColumnDefinitions="104,*"><TextBlock Grid.Column="0" Text="Первая переменная:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding LeftVariableName}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="104,*"><TextBlock Grid.Column="0" Text="Вторая переменная:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding RightVariableName}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="104,*"><TextBlock Grid.Column="0" Text="Тип сравнения:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><ComboBox Grid.Column="1" FontSize="{StaticResource FontCaption}"  ItemsSource="{x:Static presentation:RussianUiOptions.ComparisonTypes}" SelectedItem="{Binding ComparisonType, Mode=TwoWay}" ItemTemplate="{StaticResource RussianOptionTemplate}" HorizontalAlignment="Stretch" /></Grid>
                    <Grid ColumnDefinitions="104,*"><TextBlock Grid.Column="0" Text="Сообщение об ошибке:" VerticalAlignment="Top" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding FailMessage}" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap" AcceptsReturn="True" Height="52" /></Grid>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.CompareVariablesTemplate>

            <views:NodeTemplateSelector.WaitVariableUntilTemplate>
              <DataTemplate x:DataType="stepvm:WaitVariableUntilNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}" Input="{Binding Input}" Output="{Binding Output}" Classes="WaitNode" Background="{DynamicResource NodeBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}" BorderThickness="1" CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.OutputConnectorTemplate>
                  <StackPanel Margin="12" Spacing="8" Width="350">
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Переменная:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding VariableName}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Ожидаемое значение:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding ExpectedValue}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Тип сравнения:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><ComboBox Grid.Column="1" FontSize="{StaticResource FontCaption}"  ItemsSource="{x:Static presentation:RussianUiOptions.ComparisonTypes}" SelectedItem="{Binding ComparisonType, Mode=TwoWay}" ItemTemplate="{StaticResource RussianOptionTemplate}" HorizontalAlignment="Stretch" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Обновление значения:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><ComboBox Grid.Column="1" ItemsSource="{Binding PollActions}" ItemTemplate="{StaticResource RussianOptionTemplate}" SelectedItem="{Binding PollAction, Mode=TwoWay}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Базовый адрес:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding BaseUrl}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Путь запроса:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding Endpoint}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Тип ответа:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><ComboBox Grid.Column="1" ItemsSource="{Binding ResponseTypes}" ItemTemplate="{StaticResource RussianOptionTemplate}" SelectedItem="{Binding ResponseType, Mode=TwoWay}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Таймаут запроса, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding RequestTimeoutMs}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Таймаут, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Интервал, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding IntervalMs}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <CheckBox  IsChecked="{Binding FailOnTimeout}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Таймаут ведёт по выходу «Нет»" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.WaitVariableUntilTemplate>


            <views:NodeTemplateSelector.BuildTestReportTemplate>
              <DataTemplate x:DataType="stepvm:BuildTestReportNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}" Input="{Binding Input}" Output="{Binding Output}" Classes="OperatorNode" Background="{DynamicResource NodeBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}" BorderThickness="1" CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.OutputConnectorTemplate>
                  <StackPanel Margin="12" Spacing="8" Width="340">
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Переменная отчёта:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding ReportVariableName}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Переменная серийного номера:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding SerialVariableName}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="128,*"><TextBlock Grid.Column="0" Text="Тип проверки:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding TestType, Converter={StaticResource RussianUiText}, ConverterParameter=testType, Mode=TwoWay}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <CheckBox  IsChecked="{Binding IncludeAllVariables}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Включать все переменные" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.BuildTestReportTemplate>

            <views:NodeTemplateSelector.PrintLabelTemplate>
              <DataTemplate x:DataType="stepvm:PrintLabelNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}" Input="{Binding Input}" Output="{Binding Output}" Classes="OperatorNode" Background="{DynamicResource NodeBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}" BorderThickness="1" CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.OutputConnectorTemplate>
                  <StackPanel Margin="12" Spacing="8" Width="350">
                    <Grid ColumnDefinitions="132,*"><TextBlock Grid.Column="0" Text="Принтер:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding PrinterName}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <CheckBox  IsChecked="{Binding UseManualSerialNumber}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Ввести серийник вручную" TextWrapping="Wrap" /></CheckBox>
                    <Grid ColumnDefinitions="132,*" IsVisible="{Binding UseManualSerialNumber}"><TextBlock Grid.Column="0" Text="Серийник вручную:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding ManualSerialNumber}" Watermark="только цифры" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="132,*" IsVisible="{Binding IsVariableSerialMode}"><TextBlock Grid.Column="0" Text="Переменная серийного номера:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding SerialVariableName}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <TextBlock Text="{Binding CurrentTemplateName}" TextWrapping="Wrap"/>
                    <Button Content="Выбрать / настроить шаблон…" Command="{Binding ChooseTemplateCommand}"/>
                    <Grid ColumnDefinitions="132,*" IsVisible="{Binding IsManualQtProMode}"><TextBlock Grid.Column="0" Text="MAC вручную:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding ManualMacAddress}" Watermark="C0:11:A6:20:01:AC" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="132,*" IsVisible="{Binding IsVariableQtProMode}"><TextBlock Grid.Column="0" Text="Переменная короткого номера:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding SerialShortVariableName}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="132,*" IsVisible="{Binding IsVariableQtProMode}"><TextBlock Grid.Column="0" Text="Переменная MAC:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding MacVariableName}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="132,*"><TextBlock Grid.Column="0" Text="Число копий:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding Copies}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <CheckBox  IsChecked="{Binding FailOnPrinterError}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Ошибка печати ведёт по выходу «Нет»" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.PrintLabelTemplate>

            <views:NodeTemplateSelector.SendTestReportTemplate>
              <DataTemplate x:DataType="stepvm:SendTestReportNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}" Input="{Binding Input}" Output="{Binding Output}" Classes="HttpNode" Background="{DynamicResource NodeBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}" BorderThickness="1" CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeInput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate><DataTemplate x:DataType="vm:ConnectorViewModel"><nodify:NodeOutput Header="{Binding DisplayTitle}" IsConnected="{Binding IsConnected, Mode=TwoWay}" Anchor="{Binding Anchor, Mode=OneWayToSource}" /></DataTemplate></nodify:Node.OutputConnectorTemplate>
                  <StackPanel Margin="12" Spacing="8" Width="360">
                    <Grid ColumnDefinitions="132,*"><TextBlock Grid.Column="0" Text="Адрес сервера:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding ServerBaseUrl}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="132,*"><TextBlock Grid.Column="0" Text="Переменная отчёта:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding ReportVariableName}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="132,*"><TextBlock Grid.Column="0" Text="Путь запроса:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding Endpoint}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="132,*"><TextBlock Grid.Column="0" Text="Таймаут, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding TimeoutMs}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="132,*"><TextBlock Grid.Column="0" Text="Число повторов:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding RetryCount}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <Grid ColumnDefinitions="132,*"><TextBlock Grid.Column="0" Text="Пауза повтора, мс:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding RetryDelayMs}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <CheckBox  IsChecked="{Binding SaveLocalCopy}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Сохранять локальную копию" TextWrapping="Wrap" /></CheckBox>
                    <Grid ColumnDefinitions="132,*"><TextBlock Grid.Column="0" Text="Папка локальных копий:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding LocalReportsDirectory}" FontSize="{StaticResource FontCaption}" /></Grid>
                    <CheckBox  IsChecked="{Binding FailOnError}" FontSize="{StaticResource FontCaption}" ><TextBlock Text="Ошибка ведёт по выходу «Нет»" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.SendTestReportTemplate>

            <views:NodeTemplateSelector.OperatorActionTemplate>
              <DataTemplate x:DataType="stepvm:OperatorActionNodeViewModel">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderHelpTemplate}"
                             Input="{Binding Input}"
                             Output="{Binding Output}"
                             Classes="OperatorNode"
                             Background="{DynamicResource NodeBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{Binding NodeColorBrush}" HeaderBrush="{Binding NodeColorBrush}"
                             BorderThickness="1"
                             CornerRadius="8">
                  <nodify:Node.InputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeInput Header="{Binding DisplayTitle}"
                                        IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.InputConnectorTemplate>
                  <nodify:Node.OutputConnectorTemplate>
                    <DataTemplate x:DataType="vm:ConnectorViewModel">
                      <nodify:NodeOutput Header="{Binding DisplayTitle}"
                                         IsConnected="{Binding IsConnected, Mode=TwoWay}"
                                         Anchor="{Binding Anchor, Mode=OneWayToSource}" />
                    </DataTemplate>
                  </nodify:Node.OutputConnectorTemplate>

                  <StackPanel Margin="12" Spacing="8" Width="280">
                    <Grid ColumnDefinitions="108,*">
                      <TextBlock Grid.Column="0" Text="Сообщение:" VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondaryBrush}"  TextWrapping="Wrap" Margin="0,0,8,0" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Message}"
                               FontSize="{StaticResource FontCaption}"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               Height="60" />
                    </Grid>
                    <TextBlock Text="Переменная ввода (пусто — подтверждение)" TextWrapping="Wrap" />
                    <TextBox Text="{Binding InputVariable, Mode=TwoWay}" />
                    <CheckBox x:Name="ProfileOpenToggle" Classes="profileOpenToggle" />
                  </StackPanel>
                </nodify:Node>
              </DataTemplate>
            </views:NodeTemplateSelector.OperatorActionTemplate>

          </views:NodeTemplateSelector>
        </nodify:NodifyEditor.ItemTemplate>

        <nodify:NodifyEditor.ConnectionTemplate>
          <DataTemplate x:DataType="nodifyvm:ConnectionViewModel">
            <nodify:CircuitConnection Source="{Binding Source.Anchor}"
                                      Target="{Binding Target.Anchor}"
                                      Stroke="{Binding StrokeBrush}"
                                      StrokeThickness="{Binding StrokeThickness}"
                                      ArrowSize="16,10"
                                      OutlineBrush="{Binding OutlineBrush}"
                                      OutlineThickness="{Binding OutlineThickness}"
                                      PointerPressed="OnConnectionPressed"
                                      Disconnect="OnConnectionDisconnect" />
          </DataTemplate>
        </nodify:NodifyEditor.ConnectionTemplate>

        <nodify:NodifyEditor.PendingConnectionTemplate>
          <DataTemplate x:DataType="nodifyvm:PendingConnectionViewModel">
            <nodify:PendingConnection StartedCommand="{Binding StartCommand}"
                                      StrokeThickness="4"
                                      CompletedCommand="{Binding FinishCommand}"
                                      AllowOnlyConnectors="True" />
          </DataTemplate>
        </nodify:NodifyEditor.PendingConnectionTemplate>

      </nodify:NodifyEditor>

      <Grid Grid.Column="2" Grid.Row="1" ColumnDefinitions="24,Auto" Name="InspectorPanel">
        <Button Classes="edgeHandle" Command="{Binding TogglePaletteCommand}"
                ToolTip.Tip="{Binding PaletteToggleTip}" AutomationProperties.Name="Свернуть или развернуть палитру"
                Width="24" MinWidth="24" Height="64" Padding="5,12" VerticalAlignment="Center">
          <Grid>
            <PathIcon Width="10" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding !IsPaletteCollapsed}" Data="M2 0 L10 8 2 16 0 14 6 8 0 2 Z" />
            <PathIcon Width="10" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsPaletteCollapsed}" Data="M8 0 L0 8 8 16 10 14 4 8 10 2 Z" />
          </Grid>
        </Button>
        <testviews:NodePaletteView Grid.Column="1" Width="280" IsVisible="{Binding !IsPaletteCollapsed}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
