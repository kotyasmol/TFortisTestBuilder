                    <Grid ColumnDefinitions="104,*">
                      <TextBlock Grid.Column="0" Text="Repeat delay:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBox Grid.Column="1" Text="{Binding DelayBetweenRepeatsMs}" FontSize="12" />
