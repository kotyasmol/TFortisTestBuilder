<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             xmlns:logging="using:TestBuilder.Services.Logging"
             xmlns:views="using:TestBuilder.Views"
             xmlns:converters="using:TestBuilder.Converters"
             x:Class="TestBuilder.Views.TestViews.LogPanelView"
             x:DataType="vm:TestViewModel">

  <UserControl.Resources>
    <converters:CollectionEmptyConverter x:Key="CollectionEmptyConverter" />
  </UserControl.Resources>

  <Border Padding="{StaticResource PanelInset}"
          Background="{DynamicResource SurfaceBrush}">
    <Grid RowDefinitions="Auto,*">

      <Grid Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,8">
        <TextBlock Grid.Column="0"
                   Text="Логи выполнения"
                   FontSize="{StaticResource FontBody}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
          <ToggleButton x:Name="FollowLogsToggle" Content="Следить за логом" IsChecked="True"
                        IsCheckedChanged="OnFollowLogsChanged" Padding="8,0" MinHeight="28" Height="28"
                        ToolTip.Tip="Показывать конец журнала при появлении новых записей. Прокрутка вверх отключает слежение." />
          <Button x:Name="LogToBottomButton" Content="В конец" Click="OnScrollToBottomClick"
                  Padding="8,0" MinHeight="28" Height="28" ToolTip.Tip="Перейти к концу журнала и включить слежение" />
          <Button Click="OnCopyLogs"
                  Classes="ghost"
                  Height="28"
                  MinHeight="28"
                  Padding="8,0"
                  FontSize="{StaticResource FontCaption}"
                  ToolTip.Tip="Копировать выделенные строки; без выделения — весь журнал. Ctrl/⌘+C.">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
              <PathIcon Width="13"
                        Height="13"
                        Data="M8 2h11v14H8z M5 5H3v17h13v-2H5z M10 4v10h7V4z"
                        Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="Копировать"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="{StaticResource FontCaption}" />
            </StackPanel>
          </Button>
          <Button Click="OnClearLogs"
                  Classes="ghost"
                  Height="28"
                  MinHeight="28"
                  Padding="8,0"
                  FontSize="{StaticResource FontCaption}"
                  ToolTip.Tip="Очистить логи">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
              <PathIcon Width="13"
                        Height="13"
                        Data="M7 4V2h10v2h5v2H2V4h5z M5 8h14l-1 14H6z M9 10v9h2v-9H9z M13 10v9h2v-9h-2z"
                        Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="Очистить"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="{StaticResource FontCaption}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <views:RoundedPanel Grid.Row="1"
              Background="{DynamicResource SurfaceAltBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource UiCornerRadius}"
              Padding="8"
              ClipToBounds="True">
        <Grid>
          <ListBox x:Name="LogList"
                   ItemsSource="{Binding TestingLogger.Entries}"
                   ToolTip.Tip="Shift — диапазон строк, Ctrl/⌘ — отдельные строки. Ctrl/⌘+A — выделить всё."
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="logging:LogEntry">
                  <views:LogEntryView />
                </DataTemplate>
              </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Text="Здесь появится журнал выполнения теста" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                     Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"
                     IsVisible="{Binding TestingLogger.Entries.Count, Converter={StaticResource CollectionEmptyConverter}}" />
        </Grid>
      </views:RoundedPanel>

    </Grid>
  </Border>
</UserControl>
