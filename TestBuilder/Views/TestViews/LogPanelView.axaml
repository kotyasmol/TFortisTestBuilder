<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             xmlns:logging="using:TestBuilder.Services.Logging"
             xmlns:converters="using:TestBuilder.Converters"
             x:Class="TestBuilder.Views.TestViews.LogPanelView"
             x:DataType="vm:TestViewModel">

  <UserControl.Resources>
    <converters:CollectionEmptyConverter x:Key="CollectionEmptyConverter" />
  </UserControl.Resources>

  <Border Padding="12,10"
          Background="{DynamicResource SurfaceBrush}">
    <Grid RowDefinitions="Auto,*">

      <Grid Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,8">
        <TextBlock Grid.Column="0"
                   Text="Логи выполнения"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4">
          <Button Click="OnCopyLogs"
                  Classes="ghost"
                  Height="28"
                  MinHeight="28"
                  Padding="8,0"
                  FontSize="12"
                  ToolTip.Tip="Копировать все логи в буфер обмена">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
              <PathIcon Width="13"
                        Height="13"
                        Data="M8 2h11v14H8z M5 5H3v17h13v-2H5z M10 4v10h7V4z"
                        Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="Копировать"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="12" />
            </StackPanel>
          </Button>
          <Button Click="OnClearLogs"
                  Classes="ghost"
                  Height="28"
                  MinHeight="28"
                  Padding="8,0"
                  FontSize="12"
                  ToolTip.Tip="Очистить логи">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">
              <PathIcon Width="13"
                        Height="13"
                        Data="M7 4V2h10v2h5v2H2V4h5z M5 8h14l-1 14H6z M9 10v9h2v-9H9z M13 10v9h2v-9h-2z"
                        Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="Очистить"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="12" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="8"
              ClipToBounds="True">
        <Grid>
          <ScrollViewer x:Name="LogScrollViewer"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding TestingLogger.Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="logging:LogEntry">
                  <TextBlock Text="{Binding}"
                             Margin="2"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="11" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="6"
                      IsHitTestVisible="False"
                      IsVisible="{Binding TestingLogger.Entries.Count, Converter={StaticResource CollectionEmptyConverter}}">
            <PathIcon Width="28"
                      Height="28"
                      Data="M6 3h12v18H6z M8 7h8v2H8z M8 11h8v2H8z M8 15h5v2H8z"
                      Foreground="{DynamicResource TextMutedBrush}"
                      Opacity="0.7"
                      HorizontalAlignment="Center" />
            <TextBlock Text="Логи будут отображаться здесь"
                       FontSize="13"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Запустите граф для просмотра логов выполнения"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

    </Grid>
  </Border>
</UserControl>
