<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestBuilder.ViewModels"
             xmlns:views="using:TestBuilder.Views"
             xmlns:testviews="using:TestBuilder.Views.TestViews"
             x:Class="TestBuilder.Views.TestView"
             x:DataType="vm:TestViewModel">

  <Grid ColumnDefinitions="Auto,*"
        Background="{DynamicResource AppBackgroundBrush}" Margin="12">

    <views:RoundedPanel Grid.Column="0" x:Name="ProfileSidebar" Classes="profileSidebar" IsVisible="{Binding !IsProfilesCollapsed}" Width="260"
            Margin="0,0,12,0"
            Padding="{StaticResource PanelInset}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="{StaticResource UiBorderThickness}"
            CornerRadius="{StaticResource UiCornerRadius}">
      <Grid RowDefinitions="Auto,*">
        <testviews:ControlPanelView Grid.Row="0" />
        <testviews:ProfileListView Grid.Row="1" Margin="0,16,0,0" />
      </Grid>
    </views:RoundedPanel>

    <Grid x:Name="EditorLogLayout" Grid.Column="1" Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="160" />
        <RowDefinition Height="12" />
        <RowDefinition Height="160" MinHeight="100" />
      </Grid.RowDefinitions>

      <views:RoundedPanel Grid.Row="0"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="{StaticResource UiBorderThickness}"
              CornerRadius="{StaticResource UiCornerRadius}"
              ClipToBounds="True"
              Background="{DynamicResource SurfaceBrush}">
        <testviews:GraphEditorView x:Name="GraphEditor" />
      </views:RoundedPanel>

      <GridSplitter x:Name="LogHeightSplitter" Grid.Row="1"
                    Height="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    AutomationProperties.Name="Высота журнала"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Rows" />

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <views:RoundedPanel
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="{StaticResource UiBorderThickness}"
              CornerRadius="{StaticResource UiCornerRadius}"
              ClipToBounds="True"
              Background="{DynamicResource SurfaceBrush}">
        <testviews:LogPanelView x:Name="LogPanel" />
      </views:RoundedPanel>
      <views:PingMonitorView x:Name="EngineerPingPanel" Grid.Column="1" Width="250" Margin="12,0,0,0" IsVisible="{Binding ShowEngineerPing}" />
      </Grid>
    </Grid>

  </Grid>
</UserControl>
