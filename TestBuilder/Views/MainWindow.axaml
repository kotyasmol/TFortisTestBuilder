<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TestBuilder.ViewModels"
        xmlns:views="using:TestBuilder.Views"
        x:Class="TestBuilder.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="800" MinWidth="1100" MinHeight="680"
        Icon="/Assets/Brand/tfortis-test-icon.png" Title="{Binding WorkspaceTitle}" Background="{DynamicResource AppBackgroundBrush}">
  <Window.DataContext>
    <vm:MainWindowViewModel />
  </Window.DataContext>
  <Grid RowDefinitions="Auto,*">
    <Border Padding="16,8" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image Source="/Assets/Brand/tfortis-test-icon.png" Width="28" Height="28" Margin="0,0,16,0" ToolTip.Tip="TFortis TestBuilder" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding !IsSettingsOpen}">
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsEngineerWorkspace}">
            <Button Content="Редактор" Classes="workspaceNav" Classes.active="{Binding IsEditorPage}" Command="{Binding SelectPageCommand}" CommandParameter="Editor" />
            <Button Content="Регистры" Classes="workspaceNav" Classes.active="{Binding IsRegistersPage}" Command="{Binding SelectPageCommand}" CommandParameter="Registers" />
            <Button Content="Этикетки" Classes="workspaceNav" Classes.active="{Binding IsLabelsPage}" Command="{Binding SelectPageCommand}" CommandParameter="Labels" />
            <Button Content="Самопроверка" Classes="workspaceNav" Classes.active="{Binding IsSelfTestPage}" Command="{Binding SelectPageCommand}" CommandParameter="SelfTest" IsVisible="{Binding ShowSwitchTools}" />
            <Button Content="Сеть" Classes="workspaceNav" Classes.active="{Binding IsNetworkPage}" Command="{Binding SelectPageCommand}" CommandParameter="Network" IsVisible="{Binding ShowSwitchTools}" />
          </StackPanel>
          <TextBlock Text="Пульт" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding !IsEngineerWorkspace}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="Настройки" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding IsSettingsOpen}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsSettingsOpen}">
          <Button Content="Оборудование" Click="OnOpenHardware" IsVisible="{Binding IsEngineerWorkspace}" ToolTip.Tip="Устройства и регистры этого профиля" />
          <Button Content="Плата" Click="OnOpenBoard" IsVisible="{Binding ShowBoardEditor}" />
          <Button Content="{Binding SwitchWorkspaceTitle}" Command="{Binding SwitchWorkspaceCommand}" />
          <Button Content="Настройки" Command="{Binding OpenSettingsCommand}" />
        </StackPanel>
        <Button Grid.Column="2" Content="Вернуться к работе" Command="{Binding CloseSettingsCommand}" IsVisible="{Binding IsSettingsOpen}" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" IsVisible="{Binding !IsSettingsOpen}">
      <views:ProfileActionBar DataContext="{Binding TestVM}" IsVisible="{Binding IsOperatorView}" />
      <Grid Grid.Column="1">
        <Grid IsVisible="{Binding !IsEngineerWorkspace}">
          <views:StationDashboardView DataContext="{Binding TestVM}" />
        </Grid>
        <Grid IsVisible="{Binding IsEngineerWorkspace}">
          <Grid IsVisible="{Binding IsEditorPage}"><views:TestView x:Name="TestViewControl" /></Grid>
          <Grid IsVisible="{Binding IsRegistersPage}"><views:ModbusMonitoringView x:Name="ModbusViewControl" /></Grid>
          <Grid IsVisible="{Binding IsSelfTestPage}"><views:SelfTestPageView x:Name="SelfTestPageViewControl" /></Grid>
          <Grid IsVisible="{Binding IsNetworkPage}"><views:NetworkSetupView x:Name="NetworkSetupViewControl" /></Grid>
          <Grid IsVisible="{Binding IsLabelsPage}"><views:LabelPrintingView DataContext="{Binding LabelPrintingVM}" /></Grid>
        </Grid>
      </Grid>
    </Grid>
    <Grid Grid.Row="1" RowDefinitions="*,Auto" IsVisible="{Binding IsSettingsOpen}">
      <views:SettingsView x:Name="ShellSettingsViewControl" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="16,8">
        <TextBlock Text="{Binding OperatorName}" FontSize="{StaticResource FontSection}" />
        <TextBlock Text="{Binding SessionStatus}" FontSize="{StaticResource FontSection}" Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
