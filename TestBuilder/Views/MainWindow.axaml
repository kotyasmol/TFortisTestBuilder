<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TestBuilder.ViewModels"
        xmlns:views="using:TestBuilder.Views"
        x:Class="TestBuilder.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="800" MinWidth="1100" MinHeight="680"
        Icon="/Assets/Brand/tfortis-test-icon.png" Title="{Binding WorkspaceTitle}" Background="{DynamicResource AppBackgroundBrush}">
  <Window.DataContext>
    <vm:MainWindowViewModel />
  </Window.DataContext>
  <Grid RowDefinitions="Auto,*">
    <Border Padding="16,8" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <Image Source="/Assets/Brand/tfortis-test-icon.png" Width="32" Height="32" ToolTip.Tip="Тестирование оборудования TFortis" />
          <TextBlock Text="{Binding WorkspaceTitle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding SwitchWorkspaceTitle}" Command="{Binding SwitchWorkspaceCommand}"
                Margin="0,0,8,0" IsVisible="{Binding !IsSettingsOpen}" />
        <Button Grid.Column="2" Content="Настройки" Command="{Binding OpenSettingsCommand}" IsVisible="{Binding !IsSettingsOpen}" />
        <Button Grid.Column="2" Content="← Вернуться к работе" Command="{Binding CloseSettingsCommand}" IsVisible="{Binding IsSettingsOpen}" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" IsVisible="{Binding !IsSettingsOpen}">
      <Grid IsVisible="{Binding !IsEngineerWorkspace}">
        <views:StationDashboardView DataContext="{Binding TestVM}" />
      </Grid>
      <Grid IsVisible="{Binding IsEngineerWorkspace}">
        <TabControl>
          <TabItem Header="Редактор тестов"><views:TestView x:Name="TestViewControl" /></TabItem>
          <TabItem Header="Регистры Modbus"><views:ModbusMonitoringView x:Name="ModbusViewControl" /></TabItem>
          <TabItem Header="Selftest устройства"><views:SelfTestPageView x:Name="SelfTestPageViewControl" /></TabItem>
          <TabItem Header="Сеть стенда"><views:NetworkSetupView x:Name="NetworkSetupViewControl" /></TabItem>
        </TabControl>
      </Grid>
    </Grid>
    <Grid Grid.Row="1" RowDefinitions="*,Auto" IsVisible="{Binding IsSettingsOpen}">
      <views:SettingsView x:Name="ShellSettingsViewControl" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="16,8">
        <TextBlock Text="{Binding OperatorName}" FontSize="{StaticResource FontSection}" />
        <TextBlock Text="{Binding SessionStatus}" FontSize="{StaticResource FontSection}" Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
